# DevOps Intelligence monorepo: backend/, frontend/, devops-demo/, docs/
# Sub-folders may add their own .gitignore (frontend/, devops-demo/*); this file covers the whole tree.

# ---------------------------------------------------------------- dependencies
node_modules/
.pnpm-store/
.npm/
.yarn/
!.yarn/releases

# ---------------------------------------------------------------- build output
dist/
dist-ssr/
build/
out/
*.tsbuildinfo
.vite/
coverage/
.nyc_output/

# ---------------------------------------------------------------- environment & secrets
# Real values live only on the machine that runs DevOps Intelligence; commit the *.example files.
.env
.env.*
!.env.example
*.local

# Keys, certificates and kubeconfigs (DevOps Intelligence stores credentials encrypted in MongoDB, never in files)
*.pem
*.key
*.crt
*.p12
*.pfx
*.kubeconfig
kubeconfig*
!**/kubeconfig*.ts
id_rsa*
id_ed25519*
gitops_deploy_key*
*.secret.yaml
**/argocd/repo-secret.yaml

# One-off scripts with hardcoded credentials; the token in this one must be rotated, not committed.
backend/src/scripts/addSkillMineGitLab.ts

# ---------------------------------------------------------------- CI / demo artifacts
junit.xml
dockerimagename.txt
trivy-report.txt
npm-audit.txt
kube-config.yaml

# ---------------------------------------------------------------- logs
logs/
*.log
npm-debug.log*
yarn-debug.log*
yarn-error.log*
pnpm-debug.log*

# ---------------------------------------------------------------- editors & OS
.vscode/*
!.vscode/extensions.json
!.vscode/settings.json
.idea/
*.suo
*.ntvs*
*.njsproj
*.sln
*.sw?
.DS_Store
Thumbs.db
desktop.ini

# ---------------------------------------------------------------- local tooling
.claude/settings.local.json
.helm/
*.tgz
tmp/
.cache/
