<?xml version="1.0" encoding="UTF-8"?>
<mxfile host="app.diagrams.net" agent="DevOps Intelligence plan generator" version="24.7.0" type="device"><diagram name="1 Overview &amp; Architecture" id="page1"><mxGraphModel dx="1400" dy="900" grid="1" gridSize="10" guides="1" tooltips="1" connect="1" arrows="1" fold="1" page="1" pageScale="1" pageWidth="1900" pageHeight="1250" background="#ffffff" math="0" shadow="0"><root><mxCell id="0"/><mxCell id="1" parent="0"/><mxCell id="p1_1" value="&lt;b&gt;DevOps Intelligence: overview &amp; architecture&lt;/b&gt;" style="text;html=1;whiteSpace=wrap;fontSize=24;align=left;verticalAlign=top;fontColor=#0f172a;" vertex="1" parent="1"><mxGeometry x="40" y="20" width="1820" height="40" as="geometry"/></mxCell><mxCell id="p1_2" value="&lt;span style='color:#475569'&gt;One control center for GitLab CI/CD, ArgoCD GitOps, Kubernetes and Prometheus / Loki / Grafana, organised by project and environment.&lt;/span&gt;" style="text;html=1;whiteSpace=wrap;fontSize=13;align=left;verticalAlign=top;fontColor=#0f172a;" vertex="1" parent="1"><mxGeometry x="40" y="62" width="1820" height="30" as="geometry"/></mxCell><mxCell id="p1_3" value="&lt;b&gt;Mission&lt;/b&gt;&lt;ul style='margin:4px 0 0 0;padding-left:16px'&gt;&lt;li&gt;Every project: app repo + GitOps repo + cluster&lt;/li&gt;&lt;li&gt;One branch = one environment (dev → qa → staging → uat → prod)&lt;/li&gt;&lt;li&gt;Promote, roll back, debug (logs / metrics / manifests) from one UI&lt;/li&gt;&lt;li&gt;Credentials only in Connectors, encrypted at rest (AES-256-GCM)&lt;/li&gt;&lt;/ul&gt;" style="rounded=1;arcSize=8;whiteSpace=wrap;html=1;fillColor=#dbeafe;strokeColor=#1d4ed8;fontColor=#0f172a;fontSize=12;align=left;verticalAlign=top;spacing=8;" vertex="1" parent="1"><mxGeometry x="40" y="110" width="560" height="150" as="geometry"/></mxCell><mxCell id="p1_4" value="&lt;b&gt;Problems it removes&lt;/b&gt;&lt;ul style='margin:4px 0 0 0;padding-left:16px'&gt;&lt;li&gt;Jumping between GitLab, ArgoCD UI, kubectl and Grafana&lt;/li&gt;&lt;li&gt;Guessing which namespace / branch / image belongs to which env&lt;/li&gt;&lt;li&gt;Hand-made ArgoCD apps, namespaces, pull secrets, branch rules&lt;/li&gt;&lt;li&gt;No safe, audited path to production&lt;/li&gt;&lt;/ul&gt;" style="rounded=1;arcSize=8;whiteSpace=wrap;html=1;fillColor=#fffbeb;strokeColor=#a16207;fontColor=#0f172a;fontSize=12;align=left;verticalAlign=top;spacing=8;" vertex="1" parent="1"><mxGeometry x="620" y="110" width="560" height="150" as="geometry"/></mxCell><mxCell id="p1_5" value="&lt;b&gt;Tech stack&lt;/b&gt;&lt;ul style='margin:4px 0 0 0;padding-left:16px'&gt;&lt;li&gt;Frontend: React 19, Vite 8, Tailwind 4, React Router 7 (no chart/markdown libs: own SVG charts + MD renderer)&lt;/li&gt;&lt;li&gt;Backend: Node 20, Express 4, TypeScript (NodeNext ESM), Mongoose 8, @kubernetes/client-node 1.4&lt;/li&gt;&lt;li&gt;Data: MongoDB (users, projects, connectors, approvals)&lt;/li&gt;&lt;li&gt;Integrations: GitLab REST API, ArgoCD API, Kubernetes API (+ service proxy), Prometheus, Loki, Grafana&lt;/li&gt;&lt;/ul&gt;" style="rounded=1;arcSize=8;whiteSpace=wrap;html=1;fillColor=#f1f5f9;strokeColor=#334155;fontColor=#0f172a;fontSize=11;align=left;verticalAlign=top;spacing=8;" vertex="1" parent="1"><mxGeometry x="1200" y="110" width="660" height="150" as="geometry"/></mxCell><mxCell id="p1_6" value="&lt;b&gt;Users (roles)&lt;/b&gt;" style="rounded=1;arcSize=2;dashed=1;whiteSpace=wrap;html=1;fillColor=#fce7f3;strokeColor=#be185d;fontColor=#0f172a;fontSize=13;align=center;verticalAlign=top;spacing=8;fillOpacity=35;" vertex="1" parent="1"><mxGeometry x="40" y="290" width="300" height="420" as="geometry"/></mxCell><mxCell id="p1_7" value="&lt;b&gt;Developer&lt;/b&gt;&lt;br&gt;own project envs, logs, metrics, pipelines" style="rounded=1;arcSize=8;whiteSpace=wrap;html=1;fillColor=#fce7f3;strokeColor=#be185d;fontColor=#0f172a;fontSize=11;align=center;verticalAlign=middle;spacing=8;" vertex="1" parent="1"><mxGeometry x="60" y="330" width="260" height="80" as="geometry"/></mxCell><mxCell id="p1_8" value="&lt;b&gt;DevOps&lt;/b&gt;&lt;br&gt;connectors, projects, environments, promote / sync / rollback" style="rounded=1;arcSize=8;whiteSpace=wrap;html=1;fillColor=#fce7f3;strokeColor=#be185d;fontColor=#0f172a;fontSize=11;align=center;verticalAlign=middle;spacing=8;" vertex="1" parent="1"><mxGeometry x="60" y="425" width="260" height="80" as="geometry"/></mxCell><mxCell id="p1_9" value="&lt;b&gt;Manager&lt;/b&gt;&lt;br&gt;approves production changes (approval queue)" style="rounded=1;arcSize=8;whiteSpace=wrap;html=1;fillColor=#fce7f3;strokeColor=#be185d;fontColor=#0f172a;fontSize=11;align=center;verticalAlign=middle;spacing=8;" vertex="1" parent="1"><mxGeometry x="60" y="520" width="260" height="80" as="geometry"/></mxCell><mxCell id="p1_10" value="&lt;b&gt;Super Admin / Viewer&lt;/b&gt;&lt;br&gt;everything / read-only" style="rounded=1;arcSize=8;whiteSpace=wrap;html=1;fillColor=#fce7f3;strokeColor=#be185d;fontColor=#0f172a;fontSize=11;align=center;verticalAlign=middle;spacing=8;" vertex="1" parent="1"><mxGeometry x="60" y="615" width="260" height="80" as="geometry"/></mxCell><mxCell id="p1_11" value="&lt;b&gt;DevOps Intelligence platform&lt;/b&gt;" style="rounded=1;arcSize=2;dashed=1;whiteSpace=wrap;html=1;fillColor=#dbeafe;strokeColor=#1d4ed8;fontColor=#0f172a;fontSize=13;align=center;verticalAlign=top;spacing=8;fillOpacity=35;" vertex="1" parent="1"><mxGeometry x="380" y="290" width="640" height="420" as="geometry"/></mxCell><mxCell id="p1_12" value="&lt;b&gt;Frontend&lt;/b&gt; (React, :5173)&lt;br&gt;Dashboard · Getting Started · User Guide · Projects · Environments · GitLab · ArgoCD · Resource Browser · Logs · Metrics · Connectors · Approvals · Authorization" style="rounded=1;arcSize=8;whiteSpace=wrap;html=1;fillColor=#dbeafe;strokeColor=#1d4ed8;fontColor=#0f172a;fontSize=11;align=center;verticalAlign=middle;spacing=8;" vertex="1" parent="1"><mxGeometry x="410" y="330" width="580" height="90" as="geometry"/></mxCell><mxCell id="p1_13" value="&lt;b&gt;Backend API&lt;/b&gt; (Express, :5000 /api)&lt;br&gt;auth · projects (+ environments, setup, promote, rollback, manifests) · clusters · git · argocd · observability (pods, logs stream, events, metrics, resources, connectors) · approvals" style="rounded=1;arcSize=8;whiteSpace=wrap;html=1;fillColor=#dbeafe;strokeColor=#1d4ed8;fontColor=#0f172a;fontSize=11;align=center;verticalAlign=middle;spacing=8;" vertex="1" parent="1"><mxGeometry x="410" y="450" width="580" height="110" as="geometry"/></mxCell><mxCell id="p1_14" value="&lt;b&gt;MongoDB&lt;/b&gt; :27017/kubeorbit&lt;br&gt;User · Project · Cluster · GitIntegration · ArgoIntegration · ObservabilityIntegration · ApprovalRequest" style="rounded=1;arcSize=8;whiteSpace=wrap;html=1;fillColor=#f1f5f9;strokeColor=#334155;fontColor=#0f172a;fontSize=10;align=center;verticalAlign=middle;spacing=8;" vertex="1" parent="1"><mxGeometry x="410" y="590" width="280" height="90" as="geometry"/></mxCell><mxCell id="p1_15" value="&lt;b&gt;Security&lt;/b&gt;&lt;br&gt;JWT sessions · roles · secrets encrypted (CREDENTIALS_SECRET) · Secret values redacted in UI" style="rounded=1;arcSize=8;whiteSpace=wrap;html=1;fillColor=#f1f5f9;strokeColor=#334155;fontColor=#0f172a;fontSize=10;align=center;verticalAlign=middle;spacing=8;" vertex="1" parent="1"><mxGeometry x="710" y="590" width="280" height="90" as="geometry"/></mxCell><mxCell id="p1_16" value="REST + NDJSON log stream" style="edgeStyle=orthogonalEdgeStyle;rounded=1;html=1;strokeColor=#475569;strokeWidth=1.6;fontSize=11;endArrow=block;endFill=1;labelBackgroundColor=#ffffff;" edge="1" parent="1" source="p1_12" target="p1_13"><mxGeometry relative="1" as="geometry"/></mxCell><mxCell id="p1_17" value="" style="edgeStyle=orthogonalEdgeStyle;rounded=1;html=1;strokeColor=#475569;strokeWidth=1.6;fontSize=11;endArrow=block;endFill=1;labelBackgroundColor=#ffffff;" edge="1" parent="1" source="p1_13" target="p1_14"><mxGeometry relative="1" as="geometry"/></mxCell><mxCell id="p1_18" value="&lt;b&gt;Connected systems (Connectors)&lt;/b&gt;" style="rounded=1;arcSize=2;dashed=1;whiteSpace=wrap;html=1;fillColor=#f1f5f9;strokeColor=#334155;fontColor=#0f172a;fontSize=13;align=center;verticalAlign=top;spacing=8;fillOpacity=35;" vertex="1" parent="1"><mxGeometry x="1060" y="290" width="800" height="420" as="geometry"/></mxCell><mxCell id="p1_19" value="&lt;b&gt;GitLab&lt;/b&gt;&lt;br&gt;app repo · GitOps repo · CI/CD pipelines · Container Registry · MRs · protected branches · CI variables · deploy tokens/keys" style="rounded=1;arcSize=8;whiteSpace=wrap;html=1;fillColor=#ffedd5;strokeColor=#c2410c;fontColor=#0f172a;fontSize=11;align=center;verticalAlign=middle;spacing=8;" vertex="1" parent="1"><mxGeometry x="1090" y="330" width="360" height="110" as="geometry"/></mxCell><mxCell id="p1_20" value="&lt;b&gt;ArgoCD&lt;/b&gt; (https://localhost:8081)&lt;br&gt;Applications per env · sync · diff · history · rollback · repo credentials" style="rounded=1;arcSize=8;whiteSpace=wrap;html=1;fillColor=#ccfbf1;strokeColor=#0f766e;fontColor=#0f172a;fontSize=11;align=center;verticalAlign=middle;spacing=8;" vertex="1" parent="1"><mxGeometry x="1470" y="330" width="360" height="110" as="geometry"/></mxCell><mxCell id="p1_21" value="&lt;b&gt;Kubernetes&lt;/b&gt; (minikube / clusters)&lt;br&gt;namespaces · pods · logs · events · metrics-server · every resource kind" style="rounded=1;arcSize=8;whiteSpace=wrap;html=1;fillColor=#e0e7ff;strokeColor=#3730a3;fontColor=#0f172a;fontSize=11;align=center;verticalAlign=middle;spacing=8;" vertex="1" parent="1"><mxGeometry x="1090" y="465" width="360" height="110" as="geometry"/></mxCell><mxCell id="p1_22" value="&lt;b&gt;Observability&lt;/b&gt; (monitoring ns)&lt;br&gt;Prometheus (kube-prometheus-stack) · Grafana · Loki + Promtail" style="rounded=1;arcSize=8;whiteSpace=wrap;html=1;fillColor=#f3e8ff;strokeColor=#7e22ce;fontColor=#0f172a;fontSize=11;align=center;verticalAlign=middle;spacing=8;" vertex="1" parent="1"><mxGeometry x="1470" y="465" width="360" height="110" as="geometry"/></mxCell><mxCell id="p1_23" value="Reached with saved connectors. In-cluster Prometheus / Grafana / Loki go through the Kubernetes API service proxy, so no port-forward is needed for DevOps Intelligence to read them." style="rounded=1;arcSize=8;whiteSpace=wrap;html=1;fillColor=#fffbeb;strokeColor=#a16207;fontColor=#0f172a;fontSize=11;align=center;verticalAlign=middle;spacing=8;" vertex="1" parent="1"><mxGeometry x="1090" y="600" width="740" height="90" as="geometry"/></mxCell><mxCell id="p1_24" value="GitLab API" style="edgeStyle=orthogonalEdgeStyle;rounded=1;html=1;strokeColor=#475569;strokeWidth=1.6;fontSize=11;endArrow=block;endFill=1;labelBackgroundColor=#ffffff;" edge="1" parent="1" source="p1_13" target="p1_19"><mxGeometry relative="1" as="geometry"/></mxCell><mxCell id="p1_25" value="ArgoCD API" style="edgeStyle=orthogonalEdgeStyle;rounded=1;html=1;strokeColor=#475569;strokeWidth=1.6;fontSize=11;endArrow=block;endFill=1;labelBackgroundColor=#ffffff;" edge="1" parent="1" source="p1_13" target="p1_20"><mxGeometry relative="1" as="geometry"/></mxCell><mxCell id="p1_26" value="K8s API" style="edgeStyle=orthogonalEdgeStyle;rounded=1;html=1;strokeColor=#475569;strokeWidth=1.6;fontSize=11;endArrow=block;endFill=1;labelBackgroundColor=#ffffff;" edge="1" parent="1" source="p1_13" target="p1_21"><mxGeometry relative="1" as="geometry"/></mxCell><mxCell id="p1_27" value="service proxy" style="edgeStyle=orthogonalEdgeStyle;rounded=1;html=1;strokeColor=#475569;strokeWidth=1.6;fontSize=11;endArrow=block;endFill=1;labelBackgroundColor=#ffffff;" edge="1" parent="1" source="p1_13" target="p1_22"><mxGeometry relative="1" as="geometry"/></mxCell><mxCell id="p1_28" value="reconciles" style="edgeStyle=orthogonalEdgeStyle;rounded=1;html=1;strokeColor=#0f766e;strokeWidth=1.6;fontSize=11;endArrow=block;endFill=1;labelBackgroundColor=#ffffff;" edge="1" parent="1" source="p1_20" target="p1_21"><mxGeometry relative="1" as="geometry"/></mxCell><mxCell id="p1_29" value="GitOps repo" style="edgeStyle=orthogonalEdgeStyle;rounded=1;html=1;strokeColor=#0f766e;strokeWidth=1.6;fontSize=11;endArrow=block;endFill=1;dashed=1;labelBackgroundColor=#ffffff;" edge="1" parent="1" source="p1_19" target="p1_20"><mxGeometry relative="1" as="geometry"/></mxCell><mxCell id="p1_30" value="scrape / ship logs" style="edgeStyle=orthogonalEdgeStyle;rounded=1;html=1;strokeColor=#7e22ce;strokeWidth=1.6;fontSize=11;endArrow=block;endFill=1;dashed=1;labelBackgroundColor=#ffffff;" edge="1" parent="1" source="p1_21" target="p1_22"><mxGeometry relative="1" as="geometry"/></mxCell><mxCell id="p1_31" value="" style="edgeStyle=orthogonalEdgeStyle;rounded=1;html=1;strokeColor=#475569;strokeWidth=1.6;fontSize=11;endArrow=block;endFill=1;labelBackgroundColor=#ffffff;" edge="1" parent="1" source="p1_7" target="p1_12"><mxGeometry relative="1" as="geometry"/></mxCell><mxCell id="p1_32" value="" style="edgeStyle=orthogonalEdgeStyle;rounded=1;html=1;strokeColor=#475569;strokeWidth=1.6;fontSize=11;endArrow=block;endFill=1;labelBackgroundColor=#ffffff;" edge="1" parent="1" source="p1_8" target="p1_12"><mxGeometry relative="1" as="geometry"/></mxCell><mxCell id="p1_33" value="" style="edgeStyle=orthogonalEdgeStyle;rounded=1;html=1;strokeColor=#475569;strokeWidth=1.6;fontSize=11;endArrow=block;endFill=1;labelBackgroundColor=#ffffff;" edge="1" parent="1" source="p1_9" target="p1_12"><mxGeometry relative="1" as="geometry"/></mxCell><mxCell id="p1_34" value="" style="edgeStyle=orthogonalEdgeStyle;rounded=1;html=1;strokeColor=#475569;strokeWidth=1.6;fontSize=11;endArrow=block;endFill=1;labelBackgroundColor=#ffffff;" edge="1" parent="1" source="p1_10" target="p1_12"><mxGeometry relative="1" as="geometry"/></mxCell><mxCell id="p1_35" value="&lt;b&gt;Reference project (devops-demo)&lt;/b&gt;&lt;ul style='margin:4px 0 0 0;padding-left:16px'&gt;&lt;li&gt;demo-api: Express service with tests, /metrics (prom-client), chaos drills, JSON logs&lt;/li&gt;&lt;li&gt;App repo mvp.bose23/kubeorbit-demo-api · GitOps repo mvp.bose23/kubeorbit-demo-api-gitops (Kustomize base + overlays)&lt;/li&gt;&lt;li&gt;DevOps Intelligence project kubeorbit-demo with environments dev, qa, staging, uat, prod&lt;/li&gt;&lt;li&gt;Images: registry.gitlab.com/&amp;lt;group&amp;gt;/&amp;lt;app&amp;gt;/&amp;lt;env&amp;gt;:&amp;lt;env&amp;gt;-&amp;lt;date&amp;gt;-&amp;lt;sha8&amp;gt;-&amp;lt;pipeline&amp;gt;&lt;/li&gt;&lt;li&gt;Namespaces kubeorbit-demo-&amp;lt;env&amp;gt; · ArgoCD apps kubeorbit-demo-api-&amp;lt;env&amp;gt; (prod = manual sync)&lt;/li&gt;&lt;/ul&gt;" style="rounded=1;arcSize=8;whiteSpace=wrap;html=1;fillColor=#f1f5f9;strokeColor=#334155;fontColor=#0f172a;fontSize=11;align=left;verticalAlign=top;spacing=8;" vertex="1" parent="1"><mxGeometry x="40" y="740" width="900" height="200" as="geometry"/></mxCell><mxCell id="p1_36" value="&lt;b&gt;Documents&lt;/b&gt;&lt;ul style='margin:4px 0 0 0;padding-left:16px'&gt;&lt;li&gt;docs/DEVOPS_INTELLIGENCE_USER_GUIDE.md: full step-by-step guide (also in-app: /guide)&lt;/li&gt;&lt;li&gt;docs/COMPANY_DEVOPS_WORKFLOW.md: the company CI → GitOps → Kubernetes reference&lt;/li&gt;&lt;li&gt;docs/PROJECT_PLAN_AND_SPRINTS.md: blueprint, personas, sprint plan&lt;/li&gt;&lt;li&gt;devops-demo/README.md: learn DevOps stage by stage (stages 1–8)&lt;/li&gt;&lt;li&gt;This file: docs/DEVOPS_INTELLIGENCE_PROJECT_PLAN.drawio (regenerate with docs/diagrams/build_project_plan.py)&lt;/li&gt;&lt;/ul&gt;" style="rounded=1;arcSize=8;whiteSpace=wrap;html=1;fillColor=#fffbeb;strokeColor=#a16207;fontColor=#0f172a;fontSize=11;align=left;verticalAlign=top;spacing=8;" vertex="1" parent="1"><mxGeometry x="960" y="740" width="900" height="200" as="geometry"/></mxCell><mxCell id="p1_37" value="&lt;b&gt;Legend&lt;/b&gt;" style="text;html=1;whiteSpace=wrap;fontSize=12;align=left;verticalAlign=top;fontColor=#0f172a;" vertex="1" parent="1"><mxGeometry x="40" y="970" width="200" height="20" as="geometry"/></mxCell><mxCell id="p1_38" value="" style="rounded=1;arcSize=8;whiteSpace=wrap;html=1;fillColor=#dbeafe;strokeColor=#1d4ed8;fontColor=#0f172a;fontSize=12;align=center;verticalAlign=middle;spacing=8;" vertex="1" parent="1"><mxGeometry x="40" y="996" width="26" height="20" as="geometry"/></mxCell><mxCell id="p1_39" value="DevOps Intelligence" style="text;html=1;whiteSpace=wrap;fontSize=11;align=left;verticalAlign=top;fontColor=#0f172a;" vertex="1" parent="1"><mxGeometry x="74" y="996" width="220" height="22" as="geometry"/></mxCell><mxCell id="p1_40" value="" style="rounded=1;arcSize=8;whiteSpace=wrap;html=1;fillColor=#ffedd5;strokeColor=#c2410c;fontColor=#0f172a;fontSize=12;align=center;verticalAlign=middle;spacing=8;" vertex="1" parent="1"><mxGeometry x="40" y="1026" width="26" height="20" as="geometry"/></mxCell><mxCell id="p1_41" value="GitLab" style="text;html=1;whiteSpace=wrap;fontSize=11;align=left;verticalAlign=top;fontColor=#0f172a;" vertex="1" parent="1"><mxGeometry x="74" y="1026" width="220" height="22" as="geometry"/></mxCell><mxCell id="p1_42" value="" style="rounded=1;arcSize=8;whiteSpace=wrap;html=1;fillColor=#ccfbf1;strokeColor=#0f766e;fontColor=#0f172a;fontSize=12;align=center;verticalAlign=middle;spacing=8;" vertex="1" parent="1"><mxGeometry x="40" y="1056" width="26" height="20" as="geometry"/></mxCell><mxCell id="p1_43" value="ArgoCD / GitOps" style="text;html=1;whiteSpace=wrap;fontSize=11;align=left;verticalAlign=top;fontColor=#0f172a;" vertex="1" parent="1"><mxGeometry x="74" y="1056" width="220" height="22" as="geometry"/></mxCell><mxCell id="p1_44" value="" style="rounded=1;arcSize=8;whiteSpace=wrap;html=1;fillColor=#e0e7ff;strokeColor=#3730a3;fontColor=#0f172a;fontSize=12;align=center;verticalAlign=middle;spacing=8;" vertex="1" parent="1"><mxGeometry x="40" y="1086" width="26" height="20" as="geometry"/></mxCell><mxCell id="p1_45" value="Kubernetes" style="text;html=1;whiteSpace=wrap;fontSize=11;align=left;verticalAlign=top;fontColor=#0f172a;" vertex="1" parent="1"><mxGeometry x="74" y="1086" width="220" height="22" as="geometry"/></mxCell><mxCell id="p1_46" value="" style="rounded=1;arcSize=8;whiteSpace=wrap;html=1;fillColor=#f3e8ff;strokeColor=#7e22ce;fontColor=#0f172a;fontSize=12;align=center;verticalAlign=middle;spacing=8;" vertex="1" parent="1"><mxGeometry x="40" y="1116" width="26" height="20" as="geometry"/></mxCell><mxCell id="p1_47" value="Observability" style="text;html=1;whiteSpace=wrap;fontSize=11;align=left;verticalAlign=top;fontColor=#0f172a;" vertex="1" parent="1"><mxGeometry x="74" y="1116" width="220" height="22" as="geometry"/></mxCell><mxCell id="p1_48" value="" style="rounded=1;arcSize=8;whiteSpace=wrap;html=1;fillColor=#fce7f3;strokeColor=#be185d;fontColor=#0f172a;fontSize=12;align=center;verticalAlign=middle;spacing=8;" vertex="1" parent="1"><mxGeometry x="40" y="1146" width="26" height="20" as="geometry"/></mxCell><mxCell id="p1_49" value="People / roles" style="text;html=1;whiteSpace=wrap;fontSize=11;align=left;verticalAlign=top;fontColor=#0f172a;" vertex="1" parent="1"><mxGeometry x="74" y="1146" width="220" height="22" as="geometry"/></mxCell></root></mxGraphModel></diagram><diagram name="2 Delivery Flow (CI to CD)" id="page2"><mxGraphModel dx="1400" dy="900" grid="1" gridSize="10" guides="1" tooltips="1" connect="1" arrows="1" fold="1" page="1" pageScale="1" pageWidth="2000" pageHeight="1300" background="#ffffff" math="0" shadow="0"><root><mxCell id="0"/><mxCell id="1" parent="0"/><mxCell id="p2_1" value="&lt;b&gt;Delivery flow: one branch = one environment&lt;/b&gt;" style="text;html=1;whiteSpace=wrap;fontSize=24;align=left;verticalAlign=top;fontColor=#0f172a;" vertex="1" parent="1"><mxGeometry x="40" y="20" width="1920" height="40" as="geometry"/></mxCell><mxCell id="p2_2" value="&lt;span style='color:#475569'&gt;Push → GitLab CI builds a per-environment image → commits the tag to the GitOps repo → ArgoCD syncs the namespace. Promotion = fast-forward merge request.&lt;/span&gt;" style="text;html=1;whiteSpace=wrap;fontSize=13;align=left;verticalAlign=top;fontColor=#0f172a;" vertex="1" parent="1"><mxGeometry x="40" y="62" width="1920" height="30" as="geometry"/></mxCell><mxCell id="p2_3" value="&lt;b&gt;Developer&lt;/b&gt;&lt;br&gt;git push / Push code" style="rounded=1;arcSize=8;whiteSpace=wrap;html=1;fillColor=#fce7f3;strokeColor=#be185d;fontColor=#0f172a;fontSize=12;align=center;verticalAlign=middle;spacing=8;" vertex="1" parent="1"><mxGeometry x="40" y="130" width="180" height="80" as="geometry"/></mxCell><mxCell id="p2_4" value="&lt;b&gt;App repo&lt;/b&gt; (GitLab)&lt;br&gt;branches: dev · qa · staging · uat · prod (protected)" style="rounded=1;arcSize=8;whiteSpace=wrap;html=1;fillColor=#ffedd5;strokeColor=#c2410c;fontColor=#0f172a;fontSize=11;align=center;verticalAlign=middle;spacing=8;" vertex="1" parent="1"><mxGeometry x="260" y="130" width="220" height="80" as="geometry"/></mxCell><mxCell id="p2_5" value="push / merge" style="edgeStyle=orthogonalEdgeStyle;rounded=1;html=1;strokeColor=#475569;strokeWidth=1.6;fontSize=11;endArrow=block;endFill=1;labelBackgroundColor=#ffffff;" edge="1" parent="1" source="p2_3" target="p2_4"><mxGeometry relative="1" as="geometry"/></mxCell><mxCell id="p2_6" value="&lt;b&gt;GitLab CI pipeline (runs for the branch; DEPLOY_ENV = branch; rule: $CI_COMMIT_BRANCH =~ $DEPLOY_BRANCHES)&lt;/b&gt;" style="rounded=1;arcSize=2;dashed=1;whiteSpace=wrap;html=1;fillColor=#ffedd5;strokeColor=#c2410c;fontColor=#0f172a;fontSize=13;align=center;verticalAlign=top;spacing=8;fillOpacity=35;" vertex="1" parent="1"><mxGeometry x="520" y="110" width="1020" height="250" as="geometry"/></mxCell><mxCell id="p2_7" value="&lt;b&gt;code_scan&lt;/b&gt;&lt;br&gt;npm audit&lt;br&gt;(high/critical fail)" style="rounded=1;arcSize=8;whiteSpace=wrap;html=1;fillColor=#ffedd5;strokeColor=#c2410c;fontColor=#0f172a;fontSize=11;align=center;verticalAlign=middle;spacing=8;" vertex="1" parent="1"><mxGeometry x="540" y="170" width="150" height="100" as="geometry"/></mxCell><mxCell id="p2_8" value="&lt;b&gt;build&lt;/b&gt;&lt;br&gt;npm ci · tests (JUnit)&lt;br&gt;writes image name" style="rounded=1;arcSize=8;whiteSpace=wrap;html=1;fillColor=#ffedd5;strokeColor=#c2410c;fontColor=#0f172a;fontSize=11;align=center;verticalAlign=middle;spacing=8;" vertex="1" parent="1"><mxGeometry x="705" y="170" width="150" height="100" as="geometry"/></mxCell><mxCell id="p2_9" value="" style="edgeStyle=orthogonalEdgeStyle;rounded=1;html=1;strokeColor=#475569;strokeWidth=1.6;fontSize=11;endArrow=block;endFill=1;labelBackgroundColor=#ffffff;" edge="1" parent="1" source="p2_7" target="p2_8"><mxGeometry relative="1" as="geometry"/></mxCell><mxCell id="p2_10" value="&lt;b&gt;package:docker&lt;/b&gt;&lt;br&gt;docker build&lt;br&gt;BUILD_ENV=env · push" style="rounded=1;arcSize=8;whiteSpace=wrap;html=1;fillColor=#ffedd5;strokeColor=#c2410c;fontColor=#0f172a;fontSize=11;align=center;verticalAlign=middle;spacing=8;" vertex="1" parent="1"><mxGeometry x="870" y="170" width="150" height="100" as="geometry"/></mxCell><mxCell id="p2_11" value="" style="edgeStyle=orthogonalEdgeStyle;rounded=1;html=1;strokeColor=#475569;strokeWidth=1.6;fontSize=11;endArrow=block;endFill=1;labelBackgroundColor=#ffffff;" edge="1" parent="1" source="p2_8" target="p2_10"><mxGeometry relative="1" as="geometry"/></mxCell><mxCell id="p2_12" value="&lt;b&gt;package:trivy&lt;/b&gt;&lt;br&gt;image scan&lt;br&gt;fixable CRITICAL fails" style="rounded=1;arcSize=8;whiteSpace=wrap;html=1;fillColor=#ffedd5;strokeColor=#c2410c;fontColor=#0f172a;fontSize=11;align=center;verticalAlign=middle;spacing=8;" vertex="1" parent="1"><mxGeometry x="1035" y="170" width="150" height="100" as="geometry"/></mxCell><mxCell id="p2_13" value="" style="edgeStyle=orthogonalEdgeStyle;rounded=1;html=1;strokeColor=#475569;strokeWidth=1.6;fontSize=11;endArrow=block;endFill=1;labelBackgroundColor=#ffffff;" edge="1" parent="1" source="p2_10" target="p2_12"><mxGeometry relative="1" as="geometry"/></mxCell><mxCell id="p2_14" value="&lt;b&gt;kubeconfig&lt;/b&gt;&lt;br&gt;yq + kustomize&lt;br&gt;render overlay" style="rounded=1;arcSize=8;whiteSpace=wrap;html=1;fillColor=#ffedd5;strokeColor=#c2410c;fontColor=#0f172a;fontSize=11;align=center;verticalAlign=middle;spacing=8;" vertex="1" parent="1"><mxGeometry x="1200" y="170" width="150" height="100" as="geometry"/></mxCell><mxCell id="p2_15" value="" style="edgeStyle=orthogonalEdgeStyle;rounded=1;html=1;strokeColor=#475569;strokeWidth=1.6;fontSize=11;endArrow=block;endFill=1;labelBackgroundColor=#ffffff;" edge="1" parent="1" source="p2_12" target="p2_14"><mxGeometry relative="1" as="geometry"/></mxCell><mxCell id="p2_16" value="&lt;b&gt;publish_argocd&lt;/b&gt;&lt;br&gt;commit deploy(env)&lt;br&gt;via GITOPS_DEPLOY_KEY" style="rounded=1;arcSize=8;whiteSpace=wrap;html=1;fillColor=#ffedd5;strokeColor=#c2410c;fontColor=#0f172a;fontSize=11;align=center;verticalAlign=middle;spacing=8;" vertex="1" parent="1"><mxGeometry x="1365" y="170" width="150" height="100" as="geometry"/></mxCell><mxCell id="p2_17" value="" style="edgeStyle=orthogonalEdgeStyle;rounded=1;html=1;strokeColor=#475569;strokeWidth=1.6;fontSize=11;endArrow=block;endFill=1;labelBackgroundColor=#ffffff;" edge="1" parent="1" source="p2_14" target="p2_16"><mxGeometry relative="1" as="geometry"/></mxCell><mxCell id="p2_18" value="triggers" style="edgeStyle=orthogonalEdgeStyle;rounded=1;html=1;strokeColor=#475569;strokeWidth=1.6;fontSize=11;endArrow=block;endFill=1;labelBackgroundColor=#ffffff;" edge="1" parent="1" source="p2_4" target="p2_7"><mxGeometry relative="1" as="geometry"/></mxCell><mxCell id="p2_19" value="Company pipeline (reference) adds: sonar (SonarQube) · va_scan (VAPT) · email-stage (reports). Artifacts: npm-audit.txt · trivy-report.txt · kube-config.yaml · junit.xml, all visible in DevOps Intelligence → job → Reports." style="rounded=1;arcSize=8;whiteSpace=wrap;html=1;fillColor=#fffbeb;strokeColor=#a16207;fontColor=#0f172a;fontSize=11;align=center;verticalAlign=middle;spacing=8;" vertex="1" parent="1"><mxGeometry x="540" y="290" width="980" height="55" as="geometry"/></mxCell><mxCell id="p2_20" value="&lt;b&gt;GitLab Container Registry&lt;/b&gt;&lt;br&gt;…/kubeorbit-demo-api/&amp;lt;env&amp;gt;:&amp;lt;env&amp;gt;-&amp;lt;yyyymmddhhmm&amp;gt;-&amp;lt;sha8&amp;gt;-&amp;lt;pipeline&amp;gt;" style="rounded=1;arcSize=8;whiteSpace=wrap;html=1;fillColor=#ffedd5;strokeColor=#c2410c;fontColor=#0f172a;fontSize=11;align=center;verticalAlign=middle;spacing=8;" vertex="1" parent="1"><mxGeometry x="1590" y="130" width="370" height="90" as="geometry"/></mxCell><mxCell id="p2_21" value="push image" style="edgeStyle=orthogonalEdgeStyle;rounded=1;html=1;strokeColor=#475569;strokeWidth=1.6;fontSize=11;endArrow=block;endFill=1;labelBackgroundColor=#ffffff;" edge="1" parent="1" source="p2_10" target="p2_20"><mxGeometry relative="1" as="geometry"/></mxCell><mxCell id="p2_22" value="&lt;b&gt;GitOps repo&lt;/b&gt; (main)&lt;br&gt;k8s/base: deployment · service · servicemonitor&lt;br&gt;k8s/overlays/&amp;lt;env&amp;gt;: namespace, replicas, env vars, image tag" style="rounded=1;arcSize=8;whiteSpace=wrap;html=1;fillColor=#ccfbf1;strokeColor=#0f766e;fontColor=#0f172a;fontSize=11;align=center;verticalAlign=middle;spacing=8;" vertex="1" parent="1"><mxGeometry x="1590" y="250" width="370" height="110" as="geometry"/></mxCell><mxCell id="p2_23" value="commit tag (resource_group: one at a time)" style="edgeStyle=orthogonalEdgeStyle;rounded=1;html=1;strokeColor=#475569;strokeWidth=1.6;fontSize=11;endArrow=block;endFill=1;labelBackgroundColor=#ffffff;" edge="1" parent="1" source="p2_16" target="p2_22"><mxGeometry relative="1" as="geometry"/></mxCell><mxCell id="p2_24" value="&lt;b&gt;Environments (ArgoCD app per env → namespace kubeorbit-demo-&lt;env&gt;)&lt;/b&gt;" style="rounded=1;arcSize=2;dashed=1;whiteSpace=wrap;html=1;fillColor=#ccfbf1;strokeColor=#0f766e;fontColor=#0f172a;fontSize=13;align=center;verticalAlign=top;spacing=8;fillOpacity=35;" vertex="1" parent="1"><mxGeometry x="40" y="400" width="1920" height="330" as="geometry"/></mxCell><mxCell id="p2_25" value="&lt;b&gt;dev&lt;/b&gt;&lt;br&gt;ArgoCD app kubeorbit-demo-api-dev&lt;br&gt;auto-sync&lt;br&gt;chaos drills on&lt;br&gt;1 replica" style="rounded=1;arcSize=8;whiteSpace=wrap;html=1;fillColor=#dcfce7;strokeColor=#15803d;fontColor=#0f172a;fontSize=11;align=center;verticalAlign=middle;spacing=8;" vertex="1" parent="1"><mxGeometry x="80" y="450" width="300" height="120" as="geometry"/></mxCell><mxCell id="p2_26" value="&lt;b&gt;qa&lt;/b&gt;&lt;br&gt;ArgoCD app kubeorbit-demo-api-qa&lt;br&gt;auto-sync&lt;br&gt;1 replica" style="rounded=1;arcSize=8;whiteSpace=wrap;html=1;fillColor=#dcfce7;strokeColor=#15803d;fontColor=#0f172a;fontSize=11;align=center;verticalAlign=middle;spacing=8;" vertex="1" parent="1"><mxGeometry x="455" y="450" width="300" height="120" as="geometry"/></mxCell><mxCell id="p2_27" value="&lt;b&gt;staging&lt;/b&gt;&lt;br&gt;ArgoCD app kubeorbit-demo-api-staging&lt;br&gt;auto-sync&lt;br&gt;2 replicas" style="rounded=1;arcSize=8;whiteSpace=wrap;html=1;fillColor=#dcfce7;strokeColor=#15803d;fontColor=#0f172a;fontSize=11;align=center;verticalAlign=middle;spacing=8;" vertex="1" parent="1"><mxGeometry x="830" y="450" width="300" height="120" as="geometry"/></mxCell><mxCell id="p2_28" value="&lt;b&gt;uat&lt;/b&gt;&lt;br&gt;ArgoCD app kubeorbit-demo-api-uat&lt;br&gt;auto-sync&lt;br&gt;added from the UI" style="rounded=1;arcSize=8;whiteSpace=wrap;html=1;fillColor=#dcfce7;strokeColor=#15803d;fontColor=#0f172a;fontSize=11;align=center;verticalAlign=middle;spacing=8;" vertex="1" parent="1"><mxGeometry x="1205" y="450" width="300" height="120" as="geometry"/></mxCell><mxCell id="p2_29" value="&lt;b&gt;prod&lt;/b&gt;&lt;br&gt;ArgoCD app kubeorbit-demo-api-prod&lt;br&gt;&lt;b&gt;manual sync&lt;/b&gt; = approval&lt;br&gt;2 replicas + PDB" style="rounded=1;arcSize=8;whiteSpace=wrap;html=1;fillColor=#fef3c7;strokeColor=#b45309;fontColor=#0f172a;fontSize=11;align=center;verticalAlign=middle;spacing=8;" vertex="1" parent="1"><mxGeometry x="1580" y="450" width="300" height="120" as="geometry"/></mxCell><mxCell id="p2_30" value="promote: MR → ff-merge" style="edgeStyle=orthogonalEdgeStyle;rounded=1;html=1;strokeColor=#475569;strokeWidth=1.6;fontSize=11;endArrow=block;endFill=1;labelBackgroundColor=#ffffff;" edge="1" parent="1" source="p2_25" target="p2_26"><mxGeometry relative="1" as="geometry"/></mxCell><mxCell id="p2_31" value="promote: MR → ff-merge" style="edgeStyle=orthogonalEdgeStyle;rounded=1;html=1;strokeColor=#475569;strokeWidth=1.6;fontSize=11;endArrow=block;endFill=1;labelBackgroundColor=#ffffff;" edge="1" parent="1" source="p2_26" target="p2_27"><mxGeometry relative="1" as="geometry"/></mxCell><mxCell id="p2_32" value="promote: MR → ff-merge" style="edgeStyle=orthogonalEdgeStyle;rounded=1;html=1;strokeColor=#475569;strokeWidth=1.6;fontSize=11;endArrow=block;endFill=1;labelBackgroundColor=#ffffff;" edge="1" parent="1" source="p2_27" target="p2_28"><mxGeometry relative="1" as="geometry"/></mxCell><mxCell id="p2_33" value="promote: MR → ff-merge" style="edgeStyle=orthogonalEdgeStyle;rounded=1;html=1;strokeColor=#475569;strokeWidth=1.6;fontSize=11;endArrow=block;endFill=1;labelBackgroundColor=#ffffff;" edge="1" parent="1" source="p2_28" target="p2_29"><mxGeometry relative="1" as="geometry"/></mxCell><mxCell id="p2_34" value="ArgoCD watches" style="edgeStyle=orthogonalEdgeStyle;rounded=1;html=1;strokeColor=#0f766e;strokeWidth=1.6;fontSize=11;endArrow=block;endFill=1;dashed=1;labelBackgroundColor=#ffffff;" edge="1" parent="1" source="p2_22" target="p2_29"><mxGeometry relative="1" as="geometry"/></mxCell><mxCell id="p2_35" value="&lt;b&gt;Promotion states&lt;/b&gt; (Environments page): ready → Open merge request · review → Merge !N · publishing → pipeline running · syncing → ArgoCD applying · needs-sync → Sync prod · up-to-date · rolled-back → Redeploy head · blocked / diverged → fix in GitLab · failed → open the pipeline&lt;br&gt;&lt;b&gt;Rules&lt;/b&gt;: fast-forward merges only (every env runs the exact commit the previous one tested) · each env builds its own image · CI never runs kubectl; Git is the source of truth" style="rounded=1;arcSize=8;whiteSpace=wrap;html=1;fillColor=#fffbeb;strokeColor=#a16207;fontColor=#0f172a;fontSize=11;align=left;verticalAlign=middle;spacing=8;" vertex="1" parent="1"><mxGeometry x="80" y="600" width="1840" height="110" as="geometry"/></mxCell><mxCell id="p2_36" value="&lt;b&gt;Rollback &amp; redeploy&lt;/b&gt;" style="rounded=1;arcSize=2;dashed=1;whiteSpace=wrap;html=1;fillColor=#f1f5f9;strokeColor=#334155;fontColor=#0f172a;fontSize=13;align=center;verticalAlign=top;spacing=8;fillOpacity=35;" vertex="1" parent="1"><mxGeometry x="40" y="760" width="940" height="300" as="geometry"/></mxCell><mxCell id="p2_37" value="&lt;b&gt;Environments → card → History&lt;/b&gt;&lt;br&gt;every deploy: image, commit, who, when" style="rounded=1;arcSize=8;whiteSpace=wrap;html=1;fillColor=#dbeafe;strokeColor=#1d4ed8;fontColor=#0f172a;fontSize=11;align=center;verticalAlign=middle;spacing=8;" vertex="1" parent="1"><mxGeometry x="70" y="800" width="270" height="90" as="geometry"/></mxCell><mxCell id="p2_38" value="&lt;b&gt;Roll back here&lt;/b&gt;&lt;br&gt;commits rollback(env): app &amp;lt;old&amp;gt; (was &amp;lt;new&amp;gt;) by &amp;lt;user&amp;gt;" style="rounded=1;arcSize=8;whiteSpace=wrap;html=1;fillColor=#dbeafe;strokeColor=#1d4ed8;fontColor=#0f172a;fontSize=11;align=center;verticalAlign=middle;spacing=8;" vertex="1" parent="1"><mxGeometry x="370" y="800" width="270" height="90" as="geometry"/></mxCell><mxCell id="p2_39" value="&lt;b&gt;Hard refresh + sync&lt;/b&gt;&lt;br&gt;waits/retries if another ArgoCD operation runs" style="rounded=1;arcSize=8;whiteSpace=wrap;html=1;fillColor=#ccfbf1;strokeColor=#0f766e;fontColor=#0f172a;fontSize=11;align=center;verticalAlign=middle;spacing=8;" vertex="1" parent="1"><mxGeometry x="670" y="800" width="280" height="90" as="geometry"/></mxCell><mxCell id="p2_40" value="" style="edgeStyle=orthogonalEdgeStyle;rounded=1;html=1;strokeColor=#475569;strokeWidth=1.6;fontSize=11;endArrow=block;endFill=1;labelBackgroundColor=#ffffff;" edge="1" parent="1" source="p2_37" target="p2_38"><mxGeometry relative="1" as="geometry"/></mxCell><mxCell id="p2_41" value="" style="edgeStyle=orthogonalEdgeStyle;rounded=1;html=1;strokeColor=#475569;strokeWidth=1.6;fontSize=11;endArrow=block;endFill=1;labelBackgroundColor=#ffffff;" edge="1" parent="1" source="p2_38" target="p2_39"><mxGeometry relative="1" as="geometry"/></mxCell><mxCell id="p2_42" value="Card shows &lt;b&gt;Rolled back&lt;/b&gt;: the branch still has newer code. Either fix forward on dev and promote again, or &lt;b&gt;Redeploy head&lt;/b&gt; (re-runs the branch pipeline). Verified on qa: 38d6099b → c7712c27 → 38d6099b." style="rounded=1;arcSize=8;whiteSpace=wrap;html=1;fillColor=#fffbeb;strokeColor=#a16207;fontColor=#0f172a;fontSize=11;align=left;verticalAlign=middle;spacing=8;" vertex="1" parent="1"><mxGeometry x="70" y="920" width="880" height="110" as="geometry"/></mxCell><mxCell id="p2_43" value="&lt;b&gt;Credentials used by the pipeline (each limited to one job)&lt;/b&gt;" style="rounded=1;arcSize=2;dashed=1;whiteSpace=wrap;html=1;fillColor=#f1f5f9;strokeColor=#334155;fontColor=#0f172a;fontSize=13;align=center;verticalAlign=top;spacing=8;fillOpacity=35;" vertex="1" parent="1"><mxGeometry x="1020" y="760" width="940" height="300" as="geometry"/></mxCell><mxCell id="p2_44" value="&lt;b&gt;GITOPS_DEPLOY_KEY&lt;/b&gt;: SSH deploy key, write on GitOps repo · CI variable File + Protected (only env branches get it)" style="rounded=1;arcSize=8;whiteSpace=wrap;html=1;fillColor=#ffedd5;strokeColor=#c2410c;fontColor=#0f172a;fontSize=11;align=left;verticalAlign=middle;spacing=8;" vertex="1" parent="1"><mxGeometry x="1050" y="800" width="880" height="42" as="geometry"/></mxCell><mxCell id="p2_45" value="&lt;b&gt;GITOPS_REPO&lt;/b&gt;: SSH URL of the GitOps repo · CI variable" style="rounded=1;arcSize=8;whiteSpace=wrap;html=1;fillColor=#ffedd5;strokeColor=#c2410c;fontColor=#0f172a;fontSize=11;align=left;verticalAlign=middle;spacing=8;" vertex="1" parent="1"><mxGeometry x="1050" y="850" width="880" height="42" as="geometry"/></mxCell><mxCell id="p2_46" value="&lt;b&gt;DEPLOY_BRANCHES&lt;/b&gt;: regex of env branches · CI variable managed by DevOps Intelligence" style="rounded=1;arcSize=8;whiteSpace=wrap;html=1;fillColor=#dbeafe;strokeColor=#1d4ed8;fontColor=#0f172a;fontSize=11;align=left;verticalAlign=middle;spacing=8;" vertex="1" parent="1"><mxGeometry x="1050" y="900" width="880" height="42" as="geometry"/></mxCell><mxCell id="p2_47" value="&lt;b&gt;kubeorbit-argocd-read&lt;/b&gt;: read deploy token → ArgoCD repository" style="rounded=1;arcSize=8;whiteSpace=wrap;html=1;fillColor=#ccfbf1;strokeColor=#0f766e;fontColor=#0f172a;fontSize=11;align=left;verticalAlign=middle;spacing=8;" vertex="1" parent="1"><mxGeometry x="1050" y="950" width="880" height="42" as="geometry"/></mxCell><mxCell id="p2_48" value="&lt;b&gt;gitlab-registry secret&lt;/b&gt;: read_registry deploy token → pull secret in each namespace" style="rounded=1;arcSize=8;whiteSpace=wrap;html=1;fillColor=#e0e7ff;strokeColor=#3730a3;fontColor=#0f172a;fontSize=11;align=left;verticalAlign=middle;spacing=8;" vertex="1" parent="1"><mxGeometry x="1050" y="1000" width="880" height="42" as="geometry"/></mxCell></root></mxGraphModel></diagram><diagram name="3 Projects &amp; Environment Provisioning" id="page3"><mxGraphModel dx="1400" dy="900" grid="1" gridSize="10" guides="1" tooltips="1" connect="1" arrows="1" fold="1" page="1" pageScale="1" pageWidth="1900" pageHeight="1150" background="#ffffff" math="0" shadow="0"><root><mxCell id="0"/><mxCell id="1" parent="0"/><mxCell id="p3_1" value="&lt;b&gt;Projects &amp; environment provisioning&lt;/b&gt;" style="text;html=1;whiteSpace=wrap;fontSize=24;align=left;verticalAlign=top;fontColor=#0f172a;" vertex="1" parent="1"><mxGeometry x="40" y="20" width="1820" height="40" as="geometry"/></mxCell><mxCell id="p3_2" value="&lt;span style='color:#475569'&gt;A project = app repo + GitOps repo + cluster. 'Add environment' creates and checks 8 items; 'Fix' re-runs only what is missing; 'Remove' tears it down.&lt;/span&gt;" style="text;html=1;whiteSpace=wrap;fontSize=13;align=left;verticalAlign=top;fontColor=#0f172a;" vertex="1" parent="1"><mxGeometry x="40" y="62" width="1820" height="30" as="geometry"/></mxCell><mxCell id="p3_3" value="&lt;b&gt;New project (Projects page)&lt;/b&gt;&lt;ul style='margin:4px 0 0 0;padding-left:16px'&gt;&lt;li&gt;name (lowercase, namespace prefix, fixed)&lt;/li&gt;&lt;li&gt;application repo (picked from GitLab connector)&lt;/li&gt;&lt;li&gt;GitOps repo&lt;/li&gt;&lt;li&gt;first environment branch (default dev)&lt;/li&gt;&lt;li&gt;cluster (from Connectors)&lt;/li&gt;&lt;/ul&gt;" style="rounded=1;arcSize=8;whiteSpace=wrap;html=1;fillColor=#dbeafe;strokeColor=#1d4ed8;fontColor=#0f172a;fontSize=11;align=left;verticalAlign=top;spacing=8;" vertex="1" parent="1"><mxGeometry x="40" y="120" width="360" height="170" as="geometry"/></mxCell><mxCell id="p3_4" value="&lt;b&gt;Add environment (e.g. uat)&lt;/b&gt;&lt;ul style='margin:4px 0 0 0;padding-left:16px'&gt;&lt;li&gt;name = branch = overlay folder&lt;/li&gt;&lt;li&gt;create branch from (default branch)&lt;/li&gt;&lt;li&gt;namespace &amp;lt;project&amp;gt;-&amp;lt;env&amp;gt;&lt;/li&gt;&lt;li&gt;ArgoCD app &amp;lt;app-repo&amp;gt;-&amp;lt;env&amp;gt;&lt;/li&gt;&lt;li&gt;auto-sync (off for prod)&lt;/li&gt;&lt;/ul&gt;" style="rounded=1;arcSize=8;whiteSpace=wrap;html=1;fillColor=#dbeafe;strokeColor=#1d4ed8;fontColor=#0f172a;fontSize=11;align=left;verticalAlign=top;spacing=8;" vertex="1" parent="1"><mxGeometry x="40" y="330" width="360" height="170" as="geometry"/></mxCell><mxCell id="p3_5" value="project page" style="edgeStyle=orthogonalEdgeStyle;rounded=1;html=1;strokeColor=#475569;strokeWidth=1.6;fontSize=11;endArrow=block;endFill=1;labelBackgroundColor=#ffffff;" edge="1" parent="1" source="p3_3" target="p3_4"><mxGeometry relative="1" as="geometry"/></mxCell><mxCell id="p3_6" value="&lt;b&gt;The 8 checklist items (checked live, created by Add / Fix)&lt;/b&gt;" style="rounded=1;arcSize=2;dashed=1;whiteSpace=wrap;html=1;fillColor=#ccfbf1;strokeColor=#0f766e;fontColor=#0f172a;fontSize=13;align=center;verticalAlign=top;spacing=8;fillOpacity=35;" vertex="1" parent="1"><mxGeometry x="450" y="110" width="1410" height="560" as="geometry"/></mxCell><mxCell id="p3_7" value="&lt;b&gt;1 Namespace&lt;/b&gt;&lt;br&gt;kubeorbit-demo-uat, labelled app.kubernetes.io/part-of + kubeorbit.io/environment" style="rounded=1;arcSize=8;whiteSpace=wrap;html=1;fillColor=#e0e7ff;strokeColor=#3730a3;fontColor=#0f172a;fontSize=12;align=center;verticalAlign=middle;spacing=8;" vertex="1" parent="1"><mxGeometry x="480" y="150" width="660" height="105" as="geometry"/></mxCell><mxCell id="p3_8" value="&lt;b&gt;2 Pull secret&lt;/b&gt;&lt;br&gt;gitlab-registry copied from another env, else new read_registry deploy token" style="rounded=1;arcSize=8;whiteSpace=wrap;html=1;fillColor=#e0e7ff;strokeColor=#3730a3;fontColor=#0f172a;fontSize=12;align=center;verticalAlign=middle;spacing=8;" vertex="1" parent="1"><mxGeometry x="1170" y="150" width="660" height="105" as="geometry"/></mxCell><mxCell id="p3_9" value="&lt;b&gt;3 GitOps overlay&lt;/b&gt;&lt;br&gt;k8s/overlays/uat copied from a template env: namespace, APP_ENV, image path, tag not-built-yet" style="rounded=1;arcSize=8;whiteSpace=wrap;html=1;fillColor=#ccfbf1;strokeColor=#0f766e;fontColor=#0f172a;fontSize=12;align=center;verticalAlign=middle;spacing=8;" vertex="1" parent="1"><mxGeometry x="480" y="275" width="660" height="105" as="geometry"/></mxCell><mxCell id="p3_10" value="&lt;b&gt;4 ArgoCD repo access&lt;/b&gt;&lt;br&gt;repository registered with kubeorbit-argocd-read token; connection Successful" style="rounded=1;arcSize=8;whiteSpace=wrap;html=1;fillColor=#ccfbf1;strokeColor=#0f766e;fontColor=#0f172a;fontSize=12;align=center;verticalAlign=middle;spacing=8;" vertex="1" parent="1"><mxGeometry x="1170" y="275" width="660" height="105" as="geometry"/></mxCell><mxCell id="p3_11" value="&lt;b&gt;5 ArgoCD application&lt;/b&gt;&lt;br&gt;path k8s/overlays/uat → namespace, in-cluster, CreateNamespace, auto-sync if chosen" style="rounded=1;arcSize=8;whiteSpace=wrap;html=1;fillColor=#ccfbf1;strokeColor=#0f766e;fontColor=#0f172a;fontSize=12;align=center;verticalAlign=middle;spacing=8;" vertex="1" parent="1"><mxGeometry x="480" y="400" width="660" height="105" as="geometry"/></mxCell><mxCell id="p3_12" value="&lt;b&gt;6 CI deploys branch&lt;/b&gt;&lt;br&gt;DEPLOY_BRANCHES updated; branch .gitlab-ci.yml must read $DEPLOY_BRANCHES" style="rounded=1;arcSize=8;whiteSpace=wrap;html=1;fillColor=#ffedd5;strokeColor=#c2410c;fontColor=#0f172a;fontSize=12;align=center;verticalAlign=middle;spacing=8;" vertex="1" parent="1"><mxGeometry x="1170" y="400" width="660" height="105" as="geometry"/></mxCell><mxCell id="p3_13" value="&lt;b&gt;7 Branch protected&lt;/b&gt;&lt;br&gt;first env: maintainers push; later envs: merge requests only" style="rounded=1;arcSize=8;whiteSpace=wrap;html=1;fillColor=#ffedd5;strokeColor=#c2410c;fontColor=#0f172a;fontSize=12;align=center;verticalAlign=middle;spacing=8;" vertex="1" parent="1"><mxGeometry x="480" y="525" width="660" height="105" as="geometry"/></mxCell><mxCell id="p3_14" value="&lt;b&gt;8 Branch&lt;/b&gt;&lt;br&gt;created from the chosen source branch → its pipeline builds &amp; deploys" style="rounded=1;arcSize=8;whiteSpace=wrap;html=1;fillColor=#ffedd5;strokeColor=#c2410c;fontColor=#0f172a;fontSize=12;align=center;verticalAlign=middle;spacing=8;" vertex="1" parent="1"><mxGeometry x="1170" y="525" width="660" height="105" as="geometry"/></mxCell><mxCell id="p3_15" value="provision" style="edgeStyle=orthogonalEdgeStyle;rounded=1;html=1;strokeColor=#475569;strokeWidth=1.6;fontSize=11;endArrow=block;endFill=1;labelBackgroundColor=#ffffff;" edge="1" parent="1" source="p3_4" target="p3_7"><mxGeometry relative="1" as="geometry"/></mxCell><mxCell id="p3_16" value="&lt;b&gt;Result per step&lt;/b&gt;&lt;ul style='margin:4px 0 0 0;padding-left:16px'&gt;&lt;li&gt;created / updated / already there&lt;/li&gt;&lt;li&gt;failed + reason (red)&lt;/li&gt;&lt;li&gt;Fix = re-run missing only&lt;/li&gt;&lt;/ul&gt;" style="rounded=1;arcSize=8;whiteSpace=wrap;html=1;fillColor=#fffbeb;strokeColor=#a16207;fontColor=#0f172a;fontSize=11;align=left;verticalAlign=top;spacing=8;" vertex="1" parent="1"><mxGeometry x="40" y="540" width="360" height="130" as="geometry"/></mxCell><mxCell id="p3_17" value="&lt;b&gt;Remove environment&lt;/b&gt;&lt;ul style='margin:4px 0 0 0;padding-left:16px'&gt;&lt;li&gt;deletes the ArgoCD app (cascade: its resources)&lt;/li&gt;&lt;li&gt;optionally deletes the namespace&lt;/li&gt;&lt;li&gt;removes the env from DEPLOY_BRANCHES&lt;/li&gt;&lt;li&gt;keeps branch + overlay for history&lt;/li&gt;&lt;/ul&gt;" style="rounded=1;arcSize=8;whiteSpace=wrap;html=1;fillColor=#fee2e2;strokeColor=#b91c1c;fontColor=#0f172a;fontSize=11;align=left;verticalAlign=top;spacing=8;" vertex="1" parent="1"><mxGeometry x="450" y="700" width="690" height="160" as="geometry"/></mxCell><mxCell id="p3_18" value="&lt;b&gt;Per-environment shortcuts (project page)&lt;/b&gt;&lt;ul style='margin:4px 0 0 0;padding-left:16px'&gt;&lt;li&gt;Logs · Metrics · Pods (Resource Browser) · Manifests&lt;/li&gt;&lt;li&gt;Manifests: GitOps files (overlay + base) and per resource Desired (Git) vs Live (cluster) YAML&lt;/li&gt;&lt;li&gt;states: in-sync · modified · missing · extra&lt;/li&gt;&lt;/ul&gt;" style="rounded=1;arcSize=8;whiteSpace=wrap;html=1;fillColor=#dbeafe;strokeColor=#1d4ed8;fontColor=#0f172a;fontSize=11;align=left;verticalAlign=top;spacing=8;" vertex="1" parent="1"><mxGeometry x="1170" y="700" width="690" height="160" as="geometry"/></mxCell><mxCell id="p3_19" value="&lt;b&gt;Verified&lt;/b&gt;: uat added end to end: 8/8 green after promoting the $DEPLOY_BRANCHES CI rule dev → qa → staging → uat; uat answers buildEnv=uat, 'Hello from UAT'. Gotcha handled: ArgoCD answers 403 (not 404) for an app that does not exist yet." style="rounded=1;arcSize=8;whiteSpace=wrap;html=1;fillColor=#dcfce7;strokeColor=#15803d;fontColor=#0f172a;fontSize=12;align=left;verticalAlign=middle;spacing=8;" vertex="1" parent="1"><mxGeometry x="40" y="900" width="1820" height="90" as="geometry"/></mxCell></root></mxGraphModel></diagram><diagram name="4 Observability (Logs &amp; Metrics)" id="page4"><mxGraphModel dx="1400" dy="900" grid="1" gridSize="10" guides="1" tooltips="1" connect="1" arrows="1" fold="1" page="1" pageScale="1" pageWidth="1900" pageHeight="1150" background="#ffffff" math="0" shadow="0"><root><mxCell id="0"/><mxCell id="1" parent="0"/><mxCell id="p4_1" value="&lt;b&gt;Observability: logs, metrics, resources&lt;/b&gt;" style="text;html=1;whiteSpace=wrap;fontSize=24;align=left;verticalAlign=top;fontColor=#0f172a;" vertex="1" parent="1"><mxGeometry x="40" y="20" width="1820" height="40" as="geometry"/></mxCell><mxCell id="p4_2" value="&lt;span style='color:#475569'&gt;Scope everywhere: cluster → project → environment → namespace → all pods / a workload / one pod → container. Every view is a shareable URL.&lt;/span&gt;" style="text;html=1;whiteSpace=wrap;fontSize=13;align=left;verticalAlign=top;fontColor=#0f172a;" vertex="1" parent="1"><mxGeometry x="40" y="62" width="1820" height="30" as="geometry"/></mxCell><mxCell id="p4_3" value="&lt;b&gt;Kubernetes (minikube)&lt;/b&gt;" style="rounded=1;arcSize=2;dashed=1;whiteSpace=wrap;html=1;fillColor=#e0e7ff;strokeColor=#3730a3;fontColor=#0f172a;fontSize=13;align=center;verticalAlign=top;spacing=8;fillOpacity=35;" vertex="1" parent="1"><mxGeometry x="40" y="110" width="520" height="560" as="geometry"/></mxCell><mxCell id="p4_4" value="&lt;b&gt;Pods&lt;/b&gt; in kubeorbit-demo-&amp;lt;env&amp;gt; and all namespaces&lt;br&gt;stdout/stderr → /var/log/pods on the node" style="rounded=1;arcSize=8;whiteSpace=wrap;html=1;fillColor=#e0e7ff;strokeColor=#3730a3;fontColor=#0f172a;fontSize=11;align=center;verticalAlign=middle;spacing=8;" vertex="1" parent="1"><mxGeometry x="70" y="160" width="460" height="90" as="geometry"/></mxCell><mxCell id="p4_5" value="&lt;b&gt;Kubernetes API&lt;/b&gt;&lt;br&gt;pod list · logs (tail / since / previous / follow) · events · YAML" style="rounded=1;arcSize=8;whiteSpace=wrap;html=1;fillColor=#e0e7ff;strokeColor=#3730a3;fontColor=#0f172a;fontSize=11;align=center;verticalAlign=middle;spacing=8;" vertex="1" parent="1"><mxGeometry x="70" y="280" width="460" height="80" as="geometry"/></mxCell><mxCell id="p4_6" value="&lt;b&gt;metrics-server&lt;/b&gt;&lt;br&gt;live CPU / memory per pod &amp; container" style="rounded=1;arcSize=8;whiteSpace=wrap;html=1;fillColor=#e0e7ff;strokeColor=#3730a3;fontColor=#0f172a;fontSize=11;align=center;verticalAlign=middle;spacing=8;" vertex="1" parent="1"><mxGeometry x="70" y="390" width="460" height="70" as="geometry"/></mxCell><mxCell id="p4_7" value="&lt;b&gt;Prometheus&lt;/b&gt;&lt;br&gt;cAdvisor · kube-state-metrics · ServiceMonitor demo-api /metrics (15s)" style="rounded=1;arcSize=8;whiteSpace=wrap;html=1;fillColor=#f3e8ff;strokeColor=#7e22ce;fontColor=#0f172a;fontSize=11;align=center;verticalAlign=middle;spacing=8;" vertex="1" parent="1"><mxGeometry x="70" y="490" width="220" height="150" as="geometry"/></mxCell><mxCell id="p4_8" value="&lt;b&gt;Loki + Promtail&lt;/b&gt;&lt;br&gt;docker pipeline stage · 5 GiB volume · history across pods" style="rounded=1;arcSize=8;whiteSpace=wrap;html=1;fillColor=#f3e8ff;strokeColor=#7e22ce;fontColor=#0f172a;fontSize=11;align=center;verticalAlign=middle;spacing=8;" vertex="1" parent="1"><mxGeometry x="310" y="490" width="220" height="150" as="geometry"/></mxCell><mxCell id="p4_9" value="Promtail" style="edgeStyle=orthogonalEdgeStyle;rounded=1;html=1;strokeColor=#7e22ce;strokeWidth=1.6;fontSize=11;endArrow=block;endFill=1;dashed=1;labelBackgroundColor=#ffffff;" edge="1" parent="1" source="p4_4" target="p4_8"><mxGeometry relative="1" as="geometry"/></mxCell><mxCell id="p4_10" value="/metrics" style="edgeStyle=orthogonalEdgeStyle;rounded=1;html=1;strokeColor=#7e22ce;strokeWidth=1.6;fontSize=11;endArrow=block;endFill=1;dashed=1;labelBackgroundColor=#ffffff;" edge="1" parent="1" source="p4_4" target="p4_7"><mxGeometry relative="1" as="geometry"/></mxCell><mxCell id="p4_11" value="&lt;b&gt;DevOps Intelligence backend (/api/observability)&lt;/b&gt;" style="rounded=1;arcSize=2;dashed=1;whiteSpace=wrap;html=1;fillColor=#dbeafe;strokeColor=#1d4ed8;fontColor=#0f172a;fontSize=13;align=center;verticalAlign=top;spacing=8;fillOpacity=35;" vertex="1" parent="1"><mxGeometry x="600" y="110" width="560" height="560" as="geometry"/></mxCell><mxCell id="p4_12" value="&lt;b&gt;pods · pods/:ns/:pod&lt;/b&gt;&lt;br&gt;status explained (CrashLoopBackOff, ImagePullBackOff, OOMKilled…), owner, usage" style="rounded=1;arcSize=8;whiteSpace=wrap;html=1;fillColor=#dbeafe;strokeColor=#1d4ed8;fontColor=#0f172a;fontSize=11;align=center;verticalAlign=middle;spacing=8;" vertex="1" parent="1"><mxGeometry x="630" y="160" width="500" height="70" as="geometry"/></mxCell><mxCell id="p4_13" value="&lt;b&gt;logs · logs/stream (NDJSON) · logs/history (LogQL)&lt;/b&gt;&lt;br&gt;many pods merged, sorted by time" style="rounded=1;arcSize=8;whiteSpace=wrap;html=1;fillColor=#dbeafe;strokeColor=#1d4ed8;fontColor=#0f172a;fontSize=11;align=center;verticalAlign=middle;spacing=8;" vertex="1" parent="1"><mxGeometry x="630" y="250" width="500" height="70" as="geometry"/></mxCell><mxCell id="p4_14" value="&lt;b&gt;metrics/usage · metrics/range · metrics/query&lt;/b&gt;&lt;br&gt;panels per pod / per route, Grafana links" style="rounded=1;arcSize=8;whiteSpace=wrap;html=1;fillColor=#dbeafe;strokeColor=#1d4ed8;fontColor=#0f172a;fontSize=11;align=center;verticalAlign=middle;spacing=8;" vertex="1" parent="1"><mxGeometry x="630" y="340" width="500" height="70" as="geometry"/></mxCell><mxCell id="p4_15" value="&lt;b&gt;resources · resources/:kind/:ns/:name · events&lt;/b&gt;&lt;br&gt;17 kinds, Secret values redacted" style="rounded=1;arcSize=8;whiteSpace=wrap;html=1;fillColor=#dbeafe;strokeColor=#1d4ed8;fontColor=#0f172a;fontSize=11;align=center;verticalAlign=middle;spacing=8;" vertex="1" parent="1"><mxGeometry x="630" y="430" width="500" height="70" as="geometry"/></mxCell><mxCell id="p4_16" value="&lt;b&gt;connectors (+ discover, test)&lt;/b&gt;&lt;br&gt;Prometheus / Grafana / Loki: access through cluster service proxy or URL, auth none / basic / bearer" style="rounded=1;arcSize=8;whiteSpace=wrap;html=1;fillColor=#dbeafe;strokeColor=#1d4ed8;fontColor=#0f172a;fontSize=11;align=center;verticalAlign=middle;spacing=8;" vertex="1" parent="1"><mxGeometry x="630" y="520" width="500" height="110" as="geometry"/></mxCell><mxCell id="p4_17" value="" style="edgeStyle=orthogonalEdgeStyle;rounded=1;html=1;strokeColor=#475569;strokeWidth=1.6;fontSize=11;endArrow=block;endFill=1;labelBackgroundColor=#ffffff;" edge="1" parent="1" source="p4_5" target="p4_12"><mxGeometry relative="1" as="geometry"/></mxCell><mxCell id="p4_18" value="" style="edgeStyle=orthogonalEdgeStyle;rounded=1;html=1;strokeColor=#475569;strokeWidth=1.6;fontSize=11;endArrow=block;endFill=1;labelBackgroundColor=#ffffff;" edge="1" parent="1" source="p4_5" target="p4_13"><mxGeometry relative="1" as="geometry"/></mxCell><mxCell id="p4_19" value="" style="edgeStyle=orthogonalEdgeStyle;rounded=1;html=1;strokeColor=#475569;strokeWidth=1.6;fontSize=11;endArrow=block;endFill=1;labelBackgroundColor=#ffffff;" edge="1" parent="1" source="p4_6" target="p4_14"><mxGeometry relative="1" as="geometry"/></mxCell><mxCell id="p4_20" value="PromQL" style="edgeStyle=orthogonalEdgeStyle;rounded=1;html=1;strokeColor=#475569;strokeWidth=1.6;fontSize=11;endArrow=block;endFill=1;labelBackgroundColor=#ffffff;" edge="1" parent="1" source="p4_7" target="p4_14"><mxGeometry relative="1" as="geometry"/></mxCell><mxCell id="p4_21" value="LogQL" style="edgeStyle=orthogonalEdgeStyle;rounded=1;html=1;strokeColor=#475569;strokeWidth=1.6;fontSize=11;endArrow=block;endFill=1;labelBackgroundColor=#ffffff;" edge="1" parent="1" source="p4_8" target="p4_13"><mxGeometry relative="1" as="geometry"/></mxCell><mxCell id="p4_22" value="" style="edgeStyle=orthogonalEdgeStyle;rounded=1;html=1;strokeColor=#475569;strokeWidth=1.6;fontSize=11;endArrow=block;endFill=1;labelBackgroundColor=#ffffff;" edge="1" parent="1" source="p4_5" target="p4_15"><mxGeometry relative="1" as="geometry"/></mxCell><mxCell id="p4_23" value="&lt;b&gt;UI&lt;/b&gt;" style="rounded=1;arcSize=2;dashed=1;whiteSpace=wrap;html=1;fillColor=#dbeafe;strokeColor=#1d4ed8;fontColor=#0f172a;fontSize=13;align=center;verticalAlign=top;spacing=8;fillOpacity=35;" vertex="1" parent="1"><mxGeometry x="1200" y="110" width="660" height="560" as="geometry"/></mxCell><mxCell id="p4_24" value="&lt;b&gt;Logs page&lt;/b&gt;&lt;ul style='margin:4px 0 0 0;padding-left:16px'&gt;&lt;li&gt;pod list with problems flagged&lt;/li&gt;&lt;li&gt;Follow (live), Previous run, tail / time range&lt;/li&gt;&lt;li&gt;search + regex, level filter, pod colour tags&lt;/li&gt;&lt;li&gt;History (Loki), copy, download&lt;/li&gt;&lt;/ul&gt;" style="rounded=1;arcSize=8;whiteSpace=wrap;html=1;fillColor=#dbeafe;strokeColor=#1d4ed8;fontColor=#0f172a;fontSize=11;align=left;verticalAlign=top;spacing=8;" vertex="1" parent="1"><mxGeometry x="1230" y="160" width="600" height="110" as="geometry"/></mxCell><mxCell id="p4_25" value="&lt;b&gt;Metrics page&lt;/b&gt;&lt;ul style='margin:4px 0 0 0;padding-left:16px'&gt;&lt;li&gt;Application: req/s, p95 latency, 2xx/4xx/5xx, 5xx %&lt;/li&gt;&lt;li&gt;Containers: CPU &amp; memory vs limit, restarts, throttling&lt;/li&gt;&lt;li&gt;usage vs node capacity · PromQL explorer · Open in Grafana&lt;/li&gt;&lt;/ul&gt;" style="rounded=1;arcSize=8;whiteSpace=wrap;html=1;fillColor=#dbeafe;strokeColor=#1d4ed8;fontColor=#0f172a;fontSize=11;align=left;verticalAlign=top;spacing=8;" vertex="1" parent="1"><mxGeometry x="1230" y="285" width="600" height="115" as="geometry"/></mxCell><mxCell id="p4_26" value="&lt;b&gt;Resource Browser&lt;/b&gt;&lt;ul style='margin:4px 0 0 0;padding-left:16px'&gt;&lt;li&gt;every kind, sortable, only-unhealthy, auto-refresh&lt;/li&gt;&lt;li&gt;project · env chips per namespace&lt;/li&gt;&lt;li&gt;pod details: Overview / Logs / Events / Metrics / YAML&lt;/li&gt;&lt;/ul&gt;" style="rounded=1;arcSize=8;whiteSpace=wrap;html=1;fillColor=#dbeafe;strokeColor=#1d4ed8;fontColor=#0f172a;fontSize=11;align=left;verticalAlign=top;spacing=8;" vertex="1" parent="1"><mxGeometry x="1230" y="415" width="600" height="115" as="geometry"/></mxCell><mxCell id="p4_27" value="&lt;b&gt;Also&lt;/b&gt;&lt;ul style='margin:4px 0 0 0;padding-left:16px'&gt;&lt;li&gt;Environments card Details / History&lt;/li&gt;&lt;li&gt;Project → env → Logs · Metrics · Pods · Manifests&lt;/li&gt;&lt;li&gt;ArgoCD page: resources tree, diff, history, events&lt;/li&gt;&lt;/ul&gt;" style="rounded=1;arcSize=8;whiteSpace=wrap;html=1;fillColor=#dbeafe;strokeColor=#1d4ed8;fontColor=#0f172a;fontSize=11;align=left;verticalAlign=top;spacing=8;" vertex="1" parent="1"><mxGeometry x="1230" y="545" width="600" height="105" as="geometry"/></mxCell><mxCell id="p4_28" value="" style="edgeStyle=orthogonalEdgeStyle;rounded=1;html=1;strokeColor=#475569;strokeWidth=1.6;fontSize=11;endArrow=block;endFill=1;labelBackgroundColor=#ffffff;" edge="1" parent="1" source="p4_13" target="p4_24"><mxGeometry relative="1" as="geometry"/></mxCell><mxCell id="p4_29" value="" style="edgeStyle=orthogonalEdgeStyle;rounded=1;html=1;strokeColor=#475569;strokeWidth=1.6;fontSize=11;endArrow=block;endFill=1;labelBackgroundColor=#ffffff;" edge="1" parent="1" source="p4_14" target="p4_25"><mxGeometry relative="1" as="geometry"/></mxCell><mxCell id="p4_30" value="" style="edgeStyle=orthogonalEdgeStyle;rounded=1;html=1;strokeColor=#475569;strokeWidth=1.6;fontSize=11;endArrow=block;endFill=1;labelBackgroundColor=#ffffff;" edge="1" parent="1" source="p4_15" target="p4_26"><mxGeometry relative="1" as="geometry"/></mxCell><mxCell id="p4_31" value="" style="edgeStyle=orthogonalEdgeStyle;rounded=1;html=1;strokeColor=#475569;strokeWidth=1.6;fontSize=11;endArrow=block;endFill=1;labelBackgroundColor=#ffffff;" edge="1" parent="1" source="p4_12" target="p4_26"><mxGeometry relative="1" as="geometry"/></mxCell><mxCell id="p4_32" value="&lt;b&gt;Setup notes (verified on this machine)&lt;/b&gt;&lt;ul style='margin:4px 0 0 0;padding-left:16px'&gt;&lt;li&gt;kube-prometheus-stack in monitoring; Prometheus selects ServiceMonitors with label release: kube-prometheus-stack&lt;/li&gt;&lt;li&gt;minikube cAdvisor exports pod-level series only (no container label) → queries fall back to the pod cgroup; network metrics are not exported&lt;/li&gt;&lt;li&gt;Loki chart grafana/loki-stack 2.10.3 with devops-demo/platform/loki-values.yaml (docker stage, not cri); first backfill skips lines 'too far behind'&lt;/li&gt;&lt;li&gt;Grafana links need: kubectl -n monitoring port-forward svc/kube-prometheus-stack-grafana 3000:80&lt;/li&gt;&lt;/ul&gt;" style="rounded=1;arcSize=8;whiteSpace=wrap;html=1;fillColor=#fffbeb;strokeColor=#a16207;fontColor=#0f172a;fontSize=11;align=left;verticalAlign=top;spacing=8;" vertex="1" parent="1"><mxGeometry x="40" y="700" width="1820" height="150" as="geometry"/></mxCell></root></mxGraphModel></diagram><diagram name="5 Roadmap &amp; Status" id="page5"><mxGraphModel dx="1400" dy="900" grid="1" gridSize="10" guides="1" tooltips="1" connect="1" arrows="1" fold="1" page="1" pageScale="1" pageWidth="2000" pageHeight="1520" background="#ffffff" math="0" shadow="0"><root><mxCell id="0"/><mxCell id="1" parent="0"/><mxCell id="p5_1" value="&lt;b&gt;Roadmap &amp; status (as of 2026-09-29)&lt;/b&gt;" style="text;html=1;whiteSpace=wrap;fontSize=24;align=left;verticalAlign=top;fontColor=#0f172a;" vertex="1" parent="1"><mxGeometry x="40" y="20" width="1920" height="40" as="geometry"/></mxCell><mxCell id="p5_2" value="&lt;span style='color:#475569'&gt;Sprint plan from docs/PROJECT_PLAN_AND_SPRINTS.md, with what is actually built and what remains.&lt;/span&gt;" style="text;html=1;whiteSpace=wrap;fontSize=13;align=left;verticalAlign=top;fontColor=#0f172a;" vertex="1" parent="1"><mxGeometry x="40" y="62" width="1920" height="30" as="geometry"/></mxCell><mxCell id="p5_3" value="&lt;b&gt;Sprint 1 · Week 1–2: Foundations&lt;/b&gt; &lt;span style='font-weight:normal'&gt;(done)&lt;/span&gt;" style="rounded=1;arcSize=8;whiteSpace=wrap;html=1;fillColor=#dcfce7;strokeColor=#15803d;fontColor=#0f172a;fontSize=13;align=center;verticalAlign=middle;spacing=8;" vertex="1" parent="1"><mxGeometry x="40" y="110" width="620" height="50" as="geometry"/></mxCell><mxCell id="p5_4" value="&lt;b&gt;Built&lt;/b&gt;&lt;ul style='margin:4px 0 0 0;padding-left:16px'&gt;&lt;li&gt;Unified sidebar, light theme&lt;/li&gt;&lt;li&gt;Project model &amp; UI&lt;/li&gt;&lt;li&gt;Devtron-style user permission screens&lt;/li&gt;&lt;li&gt;Kubeconfig context discovery&lt;/li&gt;&lt;/ul&gt;" style="rounded=1;arcSize=8;whiteSpace=wrap;html=1;fillColor=#dcfce7;strokeColor=#15803d;fontColor=#0f172a;fontSize=11;align=left;verticalAlign=top;spacing=8;" vertex="1" parent="1"><mxGeometry x="40" y="170" width="620" height="230" as="geometry"/></mxCell><mxCell id="p5_5" value="&lt;b&gt;Remaining&lt;/b&gt;&lt;br&gt;nothing" style="rounded=1;arcSize=8;whiteSpace=wrap;html=1;fillColor=#f1f5f9;strokeColor=#64748b;fontColor=#0f172a;fontSize=11;align=left;verticalAlign=top;spacing=8;" vertex="1" parent="1"><mxGeometry x="40" y="410" width="620" height="140" as="geometry"/></mxCell><mxCell id="p5_6" value="&lt;b&gt;Sprint 2 · Week 3–4: Connectors &amp; Resource Browser&lt;/b&gt; &lt;span style='font-weight:normal'&gt;(done)&lt;/span&gt;" style="rounded=1;arcSize=8;whiteSpace=wrap;html=1;fillColor=#dcfce7;strokeColor=#15803d;fontColor=#0f172a;fontSize=13;align=center;verticalAlign=middle;spacing=8;" vertex="1" parent="1"><mxGeometry x="690" y="110" width="620" height="50" as="geometry"/></mxCell><mxCell id="p5_7" value="&lt;b&gt;Built&lt;/b&gt;&lt;ul style='margin:4px 0 0 0;padding-left:16px'&gt;&lt;li&gt;Cluster / GitLab / ArgoCD / Observability connectors (test, default, edit, delete)&lt;/li&gt;&lt;li&gt;Credentials encrypted at rest&lt;/li&gt;&lt;li&gt;Resource Browser: 17 kinds, pod details, events, YAML (secrets redacted)&lt;/li&gt;&lt;li&gt;Live &amp; streamed pod logs&lt;/li&gt;&lt;/ul&gt;" style="rounded=1;arcSize=8;whiteSpace=wrap;html=1;fillColor=#dcfce7;strokeColor=#15803d;fontColor=#0f172a;fontSize=11;align=left;verticalAlign=top;spacing=8;" vertex="1" parent="1"><mxGeometry x="690" y="170" width="620" height="230" as="geometry"/></mxCell><mxCell id="p5_8" value="&lt;b&gt;Remaining&lt;/b&gt;&lt;ul style='margin:4px 0 0 0;padding-left:16px'&gt;&lt;li&gt;Pod terminal (exec)&lt;/li&gt;&lt;li&gt;Create resources from the browser&lt;/li&gt;&lt;/ul&gt;" style="rounded=1;arcSize=8;whiteSpace=wrap;html=1;fillColor=#fee2e2;strokeColor=#b91c1c;fontColor=#0f172a;fontSize=11;align=left;verticalAlign=top;spacing=8;" vertex="1" parent="1"><mxGeometry x="690" y="410" width="620" height="140" as="geometry"/></mxCell><mxCell id="p5_9" value="&lt;b&gt;Sprint 3 · Week 5–6: GitLab CI tracking&lt;/b&gt; &lt;span style='font-weight:normal'&gt;(done)&lt;/span&gt;" style="rounded=1;arcSize=8;whiteSpace=wrap;html=1;fillColor=#dcfce7;strokeColor=#15803d;fontColor=#0f172a;fontSize=13;align=center;verticalAlign=middle;spacing=8;" vertex="1" parent="1"><mxGeometry x="1340" y="110" width="620" height="50" as="geometry"/></mxCell><mxCell id="p5_10" value="&lt;b&gt;Built&lt;/b&gt;&lt;ul style='margin:4px 0 0 0;padding-left:16px'&gt;&lt;li&gt;Pipelines, jobs, branches, commits, run pipeline&lt;/li&gt;&lt;li&gt;Live job logs, test results, auto-refresh&lt;/li&gt;&lt;li&gt;Create repo + push starter code&lt;/li&gt;&lt;li&gt;Job reports: npm audit, Trivy, rendered manifest&lt;/li&gt;&lt;li&gt;Image per environment on Environments page&lt;/li&gt;&lt;/ul&gt;" style="rounded=1;arcSize=8;whiteSpace=wrap;html=1;fillColor=#dcfce7;strokeColor=#15803d;fontColor=#0f172a;fontSize=11;align=left;verticalAlign=top;spacing=8;" vertex="1" parent="1"><mxGeometry x="1340" y="170" width="620" height="230" as="geometry"/></mxCell><mxCell id="p5_11" value="&lt;b&gt;Remaining&lt;/b&gt;&lt;ul style='margin:4px 0 0 0;padding-left:16px'&gt;&lt;li&gt;Parsed security findings (severity counts) per pipeline&lt;/li&gt;&lt;li&gt;SonarQube / Snyk stages (company pipeline)&lt;/li&gt;&lt;/ul&gt;" style="rounded=1;arcSize=8;whiteSpace=wrap;html=1;fillColor=#fee2e2;strokeColor=#b91c1c;fontColor=#0f172a;fontSize=11;align=left;verticalAlign=top;spacing=8;" vertex="1" parent="1"><mxGeometry x="1340" y="410" width="620" height="140" as="geometry"/></mxCell><mxCell id="p5_12" value="&lt;b&gt;Sprint 4 · Week 7–8: GitOps, environments &amp; promotion&lt;/b&gt; &lt;span style='font-weight:normal'&gt;(mostly done)&lt;/span&gt;" style="rounded=1;arcSize=8;whiteSpace=wrap;html=1;fillColor=#fef3c7;strokeColor=#b45309;fontColor=#0f172a;fontSize=13;align=center;verticalAlign=middle;spacing=8;" vertex="1" parent="1"><mxGeometry x="40" y="580" width="620" height="50" as="geometry"/></mxCell><mxCell id="p5_13" value="&lt;b&gt;Built&lt;/b&gt;&lt;ul style='margin:4px 0 0 0;padding-left:16px'&gt;&lt;li&gt;ArgoCD apps: sync, diff, history, rollback, terminate&lt;/li&gt;&lt;li&gt;Environments: live image/commit/pipeline/GitOps revision&lt;/li&gt;&lt;li&gt;Branch-per-env promotion via ff merge requests&lt;/li&gt;&lt;li&gt;Rollback &amp; redeploy head&lt;/li&gt;&lt;li&gt;Projects: add / fix / remove environments&lt;/li&gt;&lt;li&gt;Manifests: Git vs cluster YAML&lt;/li&gt;&lt;/ul&gt;" style="rounded=1;arcSize=8;whiteSpace=wrap;html=1;fillColor=#dcfce7;strokeColor=#15803d;fontColor=#0f172a;fontSize=11;align=left;verticalAlign=top;spacing=8;" vertex="1" parent="1"><mxGeometry x="40" y="640" width="620" height="230" as="geometry"/></mxCell><mxCell id="p5_14" value="&lt;b&gt;Remaining&lt;/b&gt;&lt;ul style='margin:4px 0 0 0;padding-left:16px'&gt;&lt;li&gt;Canary / blue-green (Argo Rollouts)&lt;/li&gt;&lt;/ul&gt;" style="rounded=1;arcSize=8;whiteSpace=wrap;html=1;fillColor=#fee2e2;strokeColor=#b91c1c;fontColor=#0f172a;fontSize=11;align=left;verticalAlign=top;spacing=8;" vertex="1" parent="1"><mxGeometry x="40" y="880" width="620" height="140" as="geometry"/></mxCell><mxCell id="p5_15" value="&lt;b&gt;Sprint 5 · Week 9–10: Approvals &amp; RBAC guardrails&lt;/b&gt; &lt;span style='font-weight:normal'&gt;(open)&lt;/span&gt;" style="rounded=1;arcSize=8;whiteSpace=wrap;html=1;fillColor=#fee2e2;strokeColor=#b91c1c;fontColor=#0f172a;fontSize=13;align=center;verticalAlign=middle;spacing=8;" vertex="1" parent="1"><mxGeometry x="690" y="580" width="620" height="50" as="geometry"/></mxCell><mxCell id="p5_16" value="&lt;b&gt;Built&lt;/b&gt;&lt;ul style='margin:4px 0 0 0;padding-left:16px'&gt;&lt;li&gt;Approval queue UI + API&lt;/li&gt;&lt;li&gt;Role checks on write routes (superadmin / devops)&lt;/li&gt;&lt;/ul&gt;" style="rounded=1;arcSize=8;whiteSpace=wrap;html=1;fillColor=#dcfce7;strokeColor=#15803d;fontColor=#0f172a;fontSize=11;align=left;verticalAlign=top;spacing=8;" vertex="1" parent="1"><mxGeometry x="690" y="640" width="620" height="230" as="geometry"/></mxCell><mxCell id="p5_17" value="&lt;b&gt;Remaining&lt;/b&gt;&lt;ul style='margin:4px 0 0 0;padding-left:16px'&gt;&lt;li&gt;Remove admin fallback + dummy logins (auth)&lt;/li&gt;&lt;li&gt;Enforce project permissions on every route&lt;/li&gt;&lt;li&gt;Approvals that execute (Sync prod, prod merge) + audit log&lt;/li&gt;&lt;li&gt;Notifications (Slack / email / webhook)&lt;/li&gt;&lt;/ul&gt;" style="rounded=1;arcSize=8;whiteSpace=wrap;html=1;fillColor=#fee2e2;strokeColor=#b91c1c;fontColor=#0f172a;fontSize=11;align=left;verticalAlign=top;spacing=8;" vertex="1" parent="1"><mxGeometry x="690" y="880" width="620" height="140" as="geometry"/></mxCell><mxCell id="p5_18" value="&lt;b&gt;Sprint 6 · Week 11–12: Observability&lt;/b&gt; &lt;span style='font-weight:normal'&gt;(mostly done)&lt;/span&gt;" style="rounded=1;arcSize=8;whiteSpace=wrap;html=1;fillColor=#fef3c7;strokeColor=#b45309;fontColor=#0f172a;fontSize=13;align=center;verticalAlign=middle;spacing=8;" vertex="1" parent="1"><mxGeometry x="1340" y="580" width="620" height="50" as="geometry"/></mxCell><mxCell id="p5_19" value="&lt;b&gt;Built&lt;/b&gt;&lt;ul style='margin:4px 0 0 0;padding-left:16px'&gt;&lt;li&gt;Logs page (live, follow, previous, history)&lt;/li&gt;&lt;li&gt;Metrics page (containers + application per route)&lt;/li&gt;&lt;li&gt;Loki + Promtail, ServiceMonitor for demo-api&lt;/li&gt;&lt;li&gt;PromQL explorer, Grafana links&lt;/li&gt;&lt;/ul&gt;" style="rounded=1;arcSize=8;whiteSpace=wrap;html=1;fillColor=#dcfce7;strokeColor=#15803d;fontColor=#0f172a;fontSize=11;align=left;verticalAlign=top;spacing=8;" vertex="1" parent="1"><mxGeometry x="1340" y="640" width="620" height="230" as="geometry"/></mxCell><mxCell id="p5_20" value="&lt;b&gt;Remaining&lt;/b&gt;&lt;ul style='margin:4px 0 0 0;padding-left:16px'&gt;&lt;li&gt;Alert rules + notifications&lt;/li&gt;&lt;li&gt;Prod ServiceMonitor after next Sync prod&lt;/li&gt;&lt;/ul&gt;" style="rounded=1;arcSize=8;whiteSpace=wrap;html=1;fillColor=#fee2e2;strokeColor=#b91c1c;fontColor=#0f172a;fontSize=11;align=left;verticalAlign=top;spacing=8;" vertex="1" parent="1"><mxGeometry x="1340" y="880" width="620" height="140" as="geometry"/></mxCell><mxCell id="p5_21" value="&lt;b&gt;Next, in order (recommended)&lt;/b&gt;" style="rounded=1;arcSize=2;dashed=1;whiteSpace=wrap;html=1;fillColor=#dbeafe;strokeColor=#1d4ed8;fontColor=#0f172a;fontSize=13;align=center;verticalAlign=top;spacing=8;fillOpacity=35;" vertex="1" parent="1"><mxGeometry x="40" y="1060" width="1920" height="250" as="geometry"/></mxCell><mxCell id="p5_22" value="&lt;b&gt;1 Authentication&lt;/b&gt;&lt;br&gt;&lt;br&gt;remove the no-token = admin fallback and dummy tokens; real sessions + expiry" style="rounded=1;arcSize=8;whiteSpace=wrap;html=1;fillColor=#fee2e2;strokeColor=#b91c1c;fontColor=#0f172a;fontSize=12;align=center;verticalAlign=middle;spacing=8;" vertex="1" parent="1"><mxGeometry x="70" y="1110" width="292" height="170" as="geometry"/></mxCell><mxCell id="p5_23" value="&lt;b&gt;2 Project permissions&lt;/b&gt;&lt;br&gt;&lt;br&gt;developers see only their projects' envs, logs, metrics" style="rounded=1;arcSize=8;whiteSpace=wrap;html=1;fillColor=#fee2e2;strokeColor=#b91c1c;fontColor=#0f172a;fontSize=12;align=center;verticalAlign=middle;spacing=8;" vertex="1" parent="1"><mxGeometry x="382" y="1110" width="292" height="170" as="geometry"/></mxCell><mxCell id="p5_24" value="" style="edgeStyle=orthogonalEdgeStyle;rounded=1;html=1;strokeColor=#475569;strokeWidth=1.6;fontSize=11;endArrow=block;endFill=1;labelBackgroundColor=#ffffff;" edge="1" parent="1" source="p5_22" target="p5_23"><mxGeometry relative="1" as="geometry"/></mxCell><mxCell id="p5_25" value="&lt;b&gt;3 Approvals that execute&lt;/b&gt;&lt;br&gt;&lt;br&gt;Sync prod / prod merge → approval → execute → audit log" style="rounded=1;arcSize=8;whiteSpace=wrap;html=1;fillColor=#fee2e2;strokeColor=#b91c1c;fontColor=#0f172a;fontSize=12;align=center;verticalAlign=middle;spacing=8;" vertex="1" parent="1"><mxGeometry x="694" y="1110" width="292" height="170" as="geometry"/></mxCell><mxCell id="p5_26" value="" style="edgeStyle=orthogonalEdgeStyle;rounded=1;html=1;strokeColor=#475569;strokeWidth=1.6;fontSize=11;endArrow=block;endFill=1;labelBackgroundColor=#ffffff;" edge="1" parent="1" source="p5_23" target="p5_25"><mxGeometry relative="1" as="geometry"/></mxCell><mxCell id="p5_27" value="&lt;b&gt;4 Alerts&lt;/b&gt;&lt;br&gt;&lt;br&gt;Prometheus rules (crash loops, failed deploys, memory) → Slack / email + card badge" style="rounded=1;arcSize=8;whiteSpace=wrap;html=1;fillColor=#fef3c7;str