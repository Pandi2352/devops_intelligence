&gt;" style="rounded=1;arcSize=2;dashed=1;whiteSpace=wrap;html=1;fillColor=#dbeafe;strokeColor=#1d4ed8;fontColor=#0f172a;fontSize=13;align=center;verticalAlign=top;spacing=8;fillOpacity=35;" vertex="1" parent="1"><mxGeometry x="40" y="942" width="900" height="216" as="geometry"/></mxCell><mxCell id="p6_18" value="&lt;b&gt;Projects /projects/:id&lt;/b&gt;: projects, environments checklist, add / fix / remove, manifests" style="rounded=1;arcSize=8;whiteSpace=wrap;html=1;fillColor=#dbeafe;strokeColor=#1d4ed8;fontColor=#0f172a;fontSize=11;align=left;verticalAlign=middle;spacing=8;" vertex="1" parent="1"><mxGeometry x="60" y="972" width="860" height="54" as="geometry"/></mxCell><mxCell id="p6_19" value="&lt;b&gt;Connectors&lt;/b&gt;: Clusters · GitLab · ArgoCD · Observability (discover)" style="rounded=1;arcSize=8;whiteSpace=wrap;html=1;fillColor=#dbeafe;strokeColor=#1d4ed8;fontColor=#0f172a;fontSize=11;align=left;verticalAlign=middle;spacing=8;" vertex="1" parent="1"><mxGeometry x="60" y="1034" width="860" height="54" as="geometry"/></mxCell><mxCell id="p6_20" value="&lt;b&gt;Authorization&lt;/b&gt;: users, permission groups (not enforced yet)" style="rounded=1;arcSize=8;whiteSpace=wrap;html=1;fillColor=#dbeafe;strokeColor=#1d4ed8;fontColor=#0f172a;fontSize=11;align=left;verticalAlign=middle;spacing=8;" vertex="1" parent="1"><mxGeometry x="60" y="1096" width="860" height="54" as="geometry"/></mxCell><mxCell id="p6_21" value="&lt;b&gt;Backend routes (Express)&lt;/b&gt;" style="rounded=1;arcSize=2;dashed=1;whiteSpace=wrap;html=1;fillColor=#f1f5f9;strokeColor=#334155;fontColor=#0f172a;fontSize=13;align=center;verticalAlign=top;spacing=8;fillOpacity=35;" vertex="1" parent="1"><mxGeometry x="980" y="110" width="980" height="600" as="geometry"/></mxCell><mxCell id="p6_22" value="&lt;b&gt;/api/auth&lt;/b&gt;: login, me, users (CRUD, role-guarded)" style="rounded=1;arcSize=8;whiteSpace=wrap;html=1;fillColor=#f1f5f9;strokeColor=#334155;fontColor=#0f172a;fontSize=11;align=left;verticalAlign=middle;spacing=8;" vertex="1" parent="1"><mxGeometry x="1000" y="145" width="940" height="60" as="geometry"/></mxCell><mxCell id="p6_23" value="&lt;b&gt;/api/projects&lt;/b&gt;: CRUD · /:id/setup · environments add / checks / provision / remove · promote · history · rollback · redeploy · details · manifests" style="rounded=1;arcSize=8;whiteSpace=wrap;html=1;fillColor=#f1f5f9;strokeColor=#334155;fontColor=#0f172a;fontSize=11;align=left;verticalAlign=middle;spacing=8;" vertex="1" parent="1"><mxGeometry x="1000" y="215" width="940" height="60" as="geometry"/></mxCell><mxCell id="p6_24" value="&lt;b&gt;/api/clusters&lt;/b&gt;: connectors CRUD, sync kubeconfig, test, resources (legacy)" style="rounded=1;arcSize=8;whiteSpace=wrap;html=1;fillColor=#f1f5f9;strokeColor=#334155;fontColor=#0f172a;fontSize=11;align=left;verticalAlign=middle;spacing=8;" vertex="1" parent="1"><mxGeometry x="1000" y="285" width="940" height="60" as="geometry"/></mxCell><mxCell id="p6_25" value="&lt;b&gt;/api/git&lt;/b&gt;: connectors, repos, commits, branches, pipelines, jobs trace &amp; artifacts, templates, create repo, push template" style="rounded=1;arcSize=8;whiteSpace=wrap;html=1;fillColor=#f1f5f9;strokeColor=#334155;fontColor=#0f172a;fontSize=11;align=left;verticalAlign=middle;spacing=8;" vertex="1" parent="1"><mxGeometry x="1000" y="355" width="940" height="60" as="geometry"/></mxCell><mxCell id="p6_26" value="&lt;b&gt;/api/argocd&lt;/b&gt;: connectors · apps list / details / tree / diff / events / refresh / sync / rollback / terminate" style="rounded=1;arcSize=8;whiteSpace=wrap;html=1;fillColor=#f1f5f9;strokeColor=#334155;fontColor=#0f172a;fontSize=11;align=left;verticalAlign=middle;spacing=8;" vertex="1" parent="1"><mxGeometry x="1000" y="425" width="940" height="60" as="geometry"/></mxCell><mxCell id="p6_27" value="&lt;b&gt;/api/observability&lt;/b&gt;: scopes, namespaces, pods, events, logs (+stream, history), metrics (usage, range, query), resources, connectors (+discover, test)" style="rounded=1;arcSize=8;whiteSpace=wrap;html=1;fillColor=#f1f5f9;strokeColor=#334155;fontColor=#0f172a;fontSize=11;align=left;verticalAlign=middle;spacing=8;" vertex="1" parent="1"><mxGeometry x="1000" y="495" width="940" height="60" as="geometry"/></mxCell><mxCell id="p6_28" value="&lt;b&gt;/api/approvals&lt;/b&gt;: list, create, review" style="rounded=1;arcSize=8;whiteSpace=wrap;html=1;fillColor=#f1f5f9;strokeColor=#334155;fontColor=#0f172a;fontSize=11;align=left;verticalAlign=middle;spacing=8;" vertex="1" parent="1"><mxGeometry x="1000" y="565" width="940" height="60" as="geometry"/></mxCell><mxCell id="p6_29" value="&lt;b&gt;/api/health&lt;/b&gt;: health check" style="rounded=1;arcSize=8;whiteSpace=wrap;html=1;fillColor=#f1f5f9;strokeColor=#334155;fontColor=#0f172a;fontSize=11;align=left;verticalAlign=middle;spacing=8;" vertex="1" parent="1"><mxGeometry x="1000" y="635" width="940" height="60" as="geometry"/></mxCell><mxCell id="p6_30" value="&lt;b&gt;Data model (MongoDB)&lt;/b&gt;&lt;ul style='margin:4px 0 0 0;padding-left:16px'&gt;&lt;li&gt;User: role superadmin / devops / developer / viewer, direct permissions&lt;/li&gt;&lt;li&gt;Project: gitLabRepos (role app / gitops), kubernetesMappings (cluster, namespaces), argoApps (appName, targetNamespace, environment, branch)&lt;/li&gt;&lt;li&gt;Cluster · GitIntegration · ArgoIntegration · ObservabilityIntegration: encrypted secrets, status, last test&lt;/li&gt;&lt;li&gt;ApprovalRequest: requested action, status, reviewer&lt;/li&gt;&lt;/ul&gt;" style="rounded=1;arcSize=8;whiteSpace=wrap;html=1;fillColor=#f1f5f9;strokeColor=#334155;fontColor=#0f172a;fontSize=11;align=left;verticalAlign=top;spacing=8;" vertex="1" parent="1"><mxGeometry x="980" y="740" width="980" height="170" as="geometry"/></mxCell><mxCell id="p6_31" value="&lt;b&gt;Shared UI building blocks&lt;/b&gt;&lt;ul style='margin:4px 0 0 0;padding-left:16px'&gt;&lt;li&gt;Modal, Dropdown (portal, searchable), Form fields, DataTable, ListToolbar, Pagination, ConfirmDialog, Toasts&lt;/li&gt;&lt;li&gt;useListQuery (search / filter / sort / page in URL), useForm, useObservabilityScope&lt;/li&gt;&lt;li&gt;LogViewer, LineChart (SVG), MetricsPanel, PodDetailsModal, MarkdownView&lt;/li&gt;&lt;/ul&gt;" style="rounded=1;arcSize=8;whiteSpace=wrap;html=1;fillColor=#fffbeb;strokeColor=#a16207;fontColor=#0f172a;fontSize=11;align=left;verticalAlign=top;spacing=8;" vertex="1" parent="1"><mxGeometry x="980" y="930" width="980" height="130" as="geometry"/></mxCell></root></mxGraphModel></diagram><diagram name="7 Roles &amp; Governance" id="page7"><mxGraphModel dx="1400" dy="900" grid="1" gridSize="10" guides="1" tooltips="1" connect="1" arrows="1" fold="1" page="1" pageScale="1" pageWidth="1900" pageHeight="1100" background="#ffffff" math="0" shadow="0"><root><mxCell id="0"/><mxCell id="1" parent="0"/><mxCell id="p7_1" value="&lt;b&gt;Roles, permissions &amp; production governance&lt;/b&gt;" style="text;html=1;whiteSpace=wrap;fontSize=24;align=left;verticalAlign=top;fontColor=#0f172a;" vertex="1" parent="1"><mxGeometry x="40" y="20" width="1820" height="40" as="geometry"/></mxCell><mxCell id="p7_2" value="&lt;span style='color:#475569'&gt;Who can do what today, and the target approval flow (Sprint 5).&lt;/span&gt;" style="text;html=1;whiteSpace=wrap;fontSize=13;align=left;verticalAlign=top;fontColor=#0f172a;" vertex="1" parent="1"><mxGeometry x="40" y="62" width="1820" height="30" as="geometry"/></mxCell><mxCell id="p7_3" value="&lt;b&gt;Super Admin&lt;/b&gt;&lt;br&gt;everything, incl. deleting projects and users" style="rounded=1;arcSize=8;whiteSpace=wrap;html=1;fillColor=#fce7f3;strokeColor=#be185d;fontColor=#0f172a;fontSize=12;align=center;verticalAlign=middle;spacing=8;" vertex="1" parent="1"><mxGeometry x="40" y="110" width="520" height="80" as="geometry"/></mxCell><mxCell id="p7_4" value="&lt;b&gt;DevOps&lt;/b&gt;&lt;br&gt;connectors, projects, add / fix / remove environments, promote, sync, rollback, PromQL" style="rounded=1;arcSize=8;whiteSpace=wrap;html=1;fillColor=#fce7f3;strokeColor=#be185d;fontColor=#0f172a;fontSize=12;align=center;verticalAlign=middle;spacing=8;" vertex="1" parent="1"><mxGeometry x="40" y="205" width="520" height="80" as="geometry"/></mxCell><mxCell id="p7_5" value="&lt;b&gt;Developer&lt;/b&gt;&lt;br&gt;view everything, logs, metrics, pipelines (target: only own projects)" style="rounded=1;arcSize=8;whiteSpace=wrap;html=1;fillColor=#fce7f3;strokeColor=#be185d;fontColor=#0f172a;fontSize=12;align=center;verticalAlign=middle;spacing=8;" vertex="1" parent="1"><mxGeometry x="40" y="300" width="520" height="80" as="geometry"/></mxCell><mxCell id="p7_6" value="&lt;b&gt;Viewer&lt;/b&gt;&lt;br&gt;read-only" style="rounded=1;arcSize=8;whiteSpace=wrap;html=1;fillColor=#fce7f3;strokeColor=#be185d;fontColor=#0f172a;fontSize=12;align=center;verticalAlign=middle;spacing=8;" vertex="1" parent="1"><mxGeometry x="40" y="395" width="520" height="80" as="geometry"/></mxCell><mxCell id="p7_7" value="&lt;b&gt;Today (risk)&lt;/b&gt;&lt;br&gt;requests without a token are treated as admin; dummy-token logins exist; project permissions are saved but not enforced. Write routes already require superadmin / devops." style="rounded=1;arcSize=8;whiteSpace=wrap;html=1;fillColor=#fee2e2;strokeColor=#b91c1c;fontColor=#0f172a;fontSize=12;align=left;verticalAlign=middle;spacing=8;" vertex="1" parent="1"><mxGeometry x="40" y="500" width="520" height="150" as="geometry"/></mxCell><mxCell id="p7_8" value="&lt;b&gt;Target production flow (Sprint 5)&lt;/b&gt;" style="rounded=1;arcSize=2;dashed=1;whiteSpace=wrap;html=1;fillColor=#dbeafe;strokeColor=#1d4ed8;fontColor=#0f172a;fontSize=13;align=center;verticalAlign=top;spacing=8;fillOpacity=35;" vertex="1" parent="1"><mxGeometry x="600" y="110" width="1260" height="540" as="geometry"/></mxCell><mxCell id="p7_9" value="&lt;b&gt;Developer / DevOps&lt;/b&gt;&lt;br&gt;&lt;br&gt;Merge uat → prod or Sync prod" style="rounded=1;arcSize=8;whiteSpace=wrap;html=1;fillColor=#fce7f3;strokeColor=#be185d;fontColor=#0f172a;fontSize=12;align=center;verticalAlign=middle;spacing=8;" vertex="1" parent="1"><mxGeometry x="640" y="170" width="360" height="150" as="geometry"/></mxCell><mxCell id="p7_10" value="&lt;b&gt;Approval request&lt;/b&gt;&lt;br&gt;&lt;br&gt;action, env, commit, image, scan results" style="rounded=1;arcSize=8;whiteSpace=wrap;html=1;fillColor=#dbeafe;strokeColor=#1d4ed8;fontColor=#0f172a;fontSize=12;align=center;verticalAlign=middle;spacing=8;" vertex="1" parent="1"><mxGeometry x="1040" y="170" width="360" height="150" as="geometry"/></mxCell><mxCell id="p7_11" value="" style="edgeStyle=orthogonalEdgeStyle;rounded=1;html=1;strokeColor=#475569;strokeWidth=1.6;fontSize=11;endArrow=block;endFill=1;labelBackgroundColor=#ffffff;" edge="1" parent="1" source="p7_9" target="p7_10"><mxGeometry relative="1" as="geometry"/></mxCell><mxCell id="p7_12" value="&lt;b&gt;Manager review&lt;/b&gt;&lt;br&gt;&lt;br&gt;Manager Approvals: approve / reject" style="rounded=1;arcSize=8;whiteSpace=wrap;html=1;fillColor=#fce7f3;strokeColor=#be185d;fontColor=#0f172a;fontSize=12;align=center;verticalAlign=middle;spacing=8;" vertex="1" parent="1"><mxGeometry x="1440" y="170" width="360" height="150" as="geometry"/></mxCell><mxCell id="p7_13" value="" style="edgeStyle=orthogonalEdgeStyle;rounded=1;html=1;strokeColor=#475569;strokeWidth=1.6;fontSize=11;endArrow=block;endFill=1;labelBackgroundColor=#ffffff;" edge="1" parent="1" source="p7_10" target="p7_12"><mxGeometry relative="1" as="geometry"/></mxCell><mxCell id="p7_14" value="&lt;b&gt;Execute&lt;/b&gt;&lt;br&gt;&lt;br&gt;DevOps Intelligence merges / syncs ArgoCD" style="rounded=1;arcSize=8;whiteSpace=wrap;html=1;fillColor=#ccfbf1;strokeColor=#0f766e;fontColor=#0f172a;fontSize=12;align=center;verticalAlign=middle;spacing=8;" vertex="1" parent="1"><mxGeometry x="640" y="390" width="360" height="150" as="geometry"/></mxCell><mxCell id="p7_15" value="" style="edgeStyle=orthogonalEdgeStyle;rounded=1;html=1;strokeColor=#475569;strokeWidth=1.6;fontSize=11;endArrow=block;endFill=1;labelBackgroundColor=#ffffff;" edge="1" parent="1" source="p7_12" target="p7_14"><mxGeometry relative="1" as="geometry"/></mxCell><mxCell id="p7_16" value="&lt;b&gt;Audit log&lt;/b&gt;&lt;br&gt;&lt;br&gt;who requested, approved, executed, when" style="rounded=1;arcSize=8;whiteSpace=wrap;html=1;fillColor=#f1f5f9;strokeColor=#334155;fontColor=#0f172a;fontSize=12;align=center;verticalAlign=middle;spacing=8;" vertex="1" parent="1"><mxGeometry x="1040" y="390" width="360" height="150" as="geometry"/></mxCell><mxCell id="p7_17" value="" style="edgeStyle=orthogonalEdgeStyle;rounded=1;html=1;strokeColor=#475569;strokeWidth=1.6;fontSize=11;endArrow=block;endFill=1;labelBackgroundColor=#ffffff;" edge="1" parent="1" source="p7_14" target="p7_16"><mxGeometry relative="1" as="geometry"/></mxCell><mxCell id="p7_18" value="&lt;b&gt;Notify&lt;/b&gt;&lt;br&gt;&lt;br&gt;Slack / email / webhook" style="rounded=1;arcSize=8;whiteSpace=wrap;html=1;fillColor=#f3e8ff;strokeColor=#7e22ce;fontColor=#0f172a;fontSize=12;align=center;verticalAlign=middle;spacing=8;" vertex="1" parent="1"><mxGeometry x="1440" y="390" width="360" height="150" as="geometry"/></mxCell><mxCell id="p7_19" value="" style="edgeStyle=orthogonalEdgeStyle;rounded=1;html=1;strokeColor=#475569;strokeWidth=1.6;fontSize=11;endArrow=block;endFill=1;labelBackgroundColor=#ffffff;" edge="1" parent="1" source="p7_16" target="p7_18"><mxGeometry relative="1" as="geometry"/></mxCell><mxCell id="p7_20" value="&lt;b&gt;Guardrails already in place&lt;/b&gt;&lt;ul style='margin:4px 0 0 0;padding-left:16px'&gt;&lt;li&gt;prod ArgoCD app is manual-sync: CI updates Git, a person presses Sync prod&lt;/li&gt;&lt;li&gt;environment branches are protected: merge requests only; only protected branches receive GITOPS_DEPLOY_KEY&lt;/li&gt;&lt;li&gt;fast-forward promotion: prod runs the exact commit uat tested · every action asks for confirmation&lt;/li&gt;&lt;li&gt;secrets never shown: tokens masked (last 4 chars), Kubernetes Secret values redacted&lt;/li&gt;&lt;/ul&gt;" style="rounded=1;arcSize=8;whiteSpace=wrap;html=1;fillColor=#dcfce7;strokeColor=#15803d;fontColor=#0f172a;fontSize=12;align=left;verticalAlign=top;spacing=8;" vertex="1" parent="1"><mxGeometry x="40" y="700" width="1820" height="140" as="geometry"/></mxCell></root></mxGraphModel></diagram><diagram name="8 Local Setup &amp; Runbook" id="page8"><mxGraphModel dx="1400" dy="900" grid="1" gridSize="10" guides="1" tooltips="1" connect="1" arrows="1" fold="1" page="1" pageScale="1" pageWidth="1900" pageHeight="1150" background="#ffffff" math="0" shadow="0"><root><mxCell id="0"/><mxCell id="1" parent="0"/><mxCell id="p8_1" value="&lt;b&gt;Local setup &amp; daily runbook&lt;/b&gt;" style="text;html=1;whiteSpace=wrap;fontSize=24;align=left;verticalAlign=top;fontColor=#0f172a;" vertex="1" parent="1"><mxGeometry x="40" y="20" width="1820" height="40" as="geometry"/></mxCell><mxCell id="p8_2" value="&lt;span style='color:#475569'&gt;Everything runs on one Windows machine with Docker Desktop + minikube. Full steps: User Guide Part A.&lt;/span&gt;" style="text;html=1;whiteSpace=wrap;fontSize=13;align=left;verticalAlign=top;fontColor=#0f172a;" vertex="1" parent="1"><mxGeometry x="40" y="62" width="1820" height="30" as="geometry"/></mxCell><mxCell id="p8_3" value="&lt;b&gt;1 minikube&lt;/b&gt;&lt;br&gt;&lt;br&gt;&lt;span style='font-family:monospace;font-size:11px'&gt;minikube start --driver=docker --cpus=4 --memory=8192&lt;br&gt;minikube addons enable metrics-server&lt;/span&gt;" style="rounded=1;arcSize=8;whiteSpace=wrap;html=1;fillColor=#e0e7ff;strokeColor=#3730a3;fontColor=#0f172a;fontSize=13;align=center;verticalAlign=middle;spacing=8;" vertex="1" parent="1"><mxGeometry x="40" y="110" width="580" height="160" as="geometry"/></mxCell><mxCell id="p8_4" value="&lt;b&gt;2 ArgoCD&lt;/b&gt;&lt;br&gt;&lt;br&gt;&lt;span style='font-family:monospace;font-size:11px'&gt;kubectl create ns argocd · kubectl apply -n argocd -f …/install.yaml&lt;br&gt;port-forward svc/argocd-server 8081:443&lt;/span&gt;" style="rounded=1;arcSize=8;whiteSpace=wrap;html=1;fillColor=#ccfbf1;strokeColor=#0f766e;fontColor=#0f172a;fontSize=13;align=center;verticalAlign=middle;spacing=8;" vertex="1" parent="1"><mxGeometry x="650" y="110" width="580" height="160" as="geometry"/></mxCell><mxCell id="p8_5" value="" style="edgeStyle=orthogonalEdgeStyle;rounded=1;html=1;strokeColor=#475569;strokeWidth=1.6;fontSize=11;endArrow=block;endFill=1;labelBackgroundColor=#ffffff;" edge="1" parent="1" source="p8_3" target="p8_4"><mxGeometry relative="1" as="geometry"/></mxCell><mxCell id="p8_6" value="&lt;b&gt;3 Prometheus + Grafana&lt;/b&gt;&lt;br&gt;&lt;br&gt;&lt;span style='font-family:monospace;font-size:11px'&gt;helm install kube-prometheus-stack prometheus-community/kube-prometheus-stack -n monitoring --create-namespace&lt;/span&gt;" style="rounded=1;arcSize=8;whiteSpace=wrap;html=1;fillColor=#f3e8ff;strokeColor=#7e22ce;fontColor=#0f172a;fontSize=13;align=center;verticalAlign=middle;spacing=8;" vertex="1" parent="1"><mxGeometry x="1260" y="110" width="580" height="160" as="geometry"/></mxCell><mxCell id="p8_7" value="" style="edgeStyle=orthogonalEdgeStyle;rounded=1;html=1;strokeColor=#475569;strokeWidth=1.6;fontSize=11;endArrow=block;endFill=1;labelBackgroundColor=#ffffff;" edge="1" parent="1" source="p8_4" target="p8_6"><mxGeometry relative="1" as="geometry"/></mxCell><mxCell id="p8_8" value="&lt;b&gt;4 Loki&lt;/b&gt;&lt;br&gt;&lt;br&gt;&lt;span style='font-family:monospace;font-size:11px'&gt;helm install loki grafana/loki-stack --version 2.10.3 -n monitoring -f devops-demo/platform/loki-values.yaml&lt;/span&gt;" style="rounded=1;arcSize=8;whiteSpace=wrap;html=1;fillColor=#f3e8ff;strokeColor=#7e22ce;fontColor=#0f172a;fontSize=13;align=center;verticalAlign=middle;spacing=8;" vertex="1" parent="1"><mxGeometry x="40" y="300" width="580" height="160" as="geometry"/></mxCell><mxCell id="p8_9" value="" style="edgeStyle=orthogonalEdgeStyle;rounded=1;html=1;strokeColor=#475569;strokeWidth=1.6;fontSize=11;endArrow=block;endFill=1;labelBackgroundColor=#ffffff;" edge="1" parent="1" source="p8_6" target="p8_8"><mxGeometry relative="1" as="geometry"/></mxCell><mxCell id="p8_10" value="&lt;b&gt;5 MongoDB&lt;/b&gt;&lt;br&gt;&lt;br&gt;&lt;span style='font-family:monospace;font-size:11px'&gt;127.0.0.1:27017 (local install or docker run mongo:8)&lt;/span&gt;" style="rounded=1;arcSize=8;whiteSpace=wrap;html=1;fillColor=#f1f5f9;strokeColor=#334155;fontColor=#0f172a;fontSize=13;align=center;verticalAlign=middle;spacing=8;" vertex="1" parent="1"><mxGeometry x="650" y="300" width="580" height="160" as="geometry"/></mxCell><mxCell id="p8_11" value="" style="edgeStyle=orthogonalEdgeStyle;rounded=1;html=1;strokeColor=#475569;strokeWidth=1.6;fontSize=11;endArrow=block;endFill=1;labelBackgroundColor=#ffffff;" edge="1" parent="1" source="p8_8" target="p8_10"><mxGeometry relative="1" as="geometry"/></mxCell><mxCell id="p8_12" value="&lt;b&gt;6 Backend&lt;/b&gt;&lt;br&gt;&lt;br&gt;&lt;span style='font-family:monospace;font-size:11px'&gt;cd backend · .env (JWT_SECRET, CREDENTIALS_SECRET) · npm run build · npm start → :5000&lt;/span&gt;" style="rounded=1;arcSize=8;whiteSpace=wrap;html=1;fillColor=#dbeafe;strokeColor=#1d4ed8;fontColor=#0f172a;fontSize=13;align=center;verticalAlign=middle;spacing=8;" vertex="1" parent="1"><mxGeometry x="1260" y="300" width="580" height="160" as="geometry"/></mxCell><mxCell id="p8_13" value="" style="edgeStyle=orthogonalEdgeStyle;rounded=1;html=1;strokeColor=#475569;strokeWidth=1.6;fontSize=11;endArrow=block;endFill=1;labelBackgroundColor=#ffffff;" edge="1" parent="1" source="p8_10" target="p8_12"><mxGeometry relative="1" as="geometry"/></mxCell><mxCell id="p8_14" value="&lt;b&gt;7 Frontend&lt;/b&gt;&lt;br&gt;&lt;br&gt;&lt;span style='font-family:monospace;font-size:11px'&gt;cd frontend · npm run dev → :5173&lt;/span&gt;" style="rounded=1;arcSize=8;whiteSpace=wrap;html=1;fillColor=#dbeafe;strokeColor=#1d4ed8;fontColor=#0f172a;fontSize=13;align=center;verticalAlign=middle;spacing=8;" vertex="1" parent="1"><mxGeometry x="40" y="490" width="580" height="160" as="geometry"/></mxCell><mxCell id="p8_15" value="" style="edgeStyle=orthogonalEdgeStyle;rounded=1;html=1;strokeColor=#475569;strokeWidth=1.6;fontSize=11;endArrow=block;endFill=1;labelBackgroundColor=#ffffff;" edge="1" parent="1" source="p8_12" target="p8_14"><mxGeometry relative="1" as="geometry"/></mxCell><mxCell id="p8_16" value="&lt;b&gt;8 Connectors&lt;/b&gt;&lt;br&gt;&lt;br&gt;&lt;span style='font-family:monospace;font-size:11px'&gt;Clusters: Sync kubeconfig · GitLab PAT (api, read_registry, write_repository) · ArgoCD admin · Observability: Discover&lt;/span&gt;" style="rounded=1;arcSize=8;whiteSpace=wrap;html=1;fillColor=#dbeafe;strokeColor=#1d4ed8;fontColor=#0f172a;fontSize=13;align=center;verticalAlign=middle;spacing=8;" vertex="1" parent="1"><mxGeometry x="650" y="490" width="580" height="160" as="geometry"/></mxCell><mxCell id="p8_17" value="" style="edgeStyle=orthogonalEdgeStyle;rounded=1;html=1;strokeColor=#475569;strokeWidth=1.6;fontSize=11;endArrow=block;endFill=1;labelBackgroundColor=#ffffff;" edge="1" parent="1" source="p8_14" target="p8_16"><mxGeometry relative="1" as="geometry"/></mxCell><mxCell id="p8_18" value="&lt;b&gt;9 First project&lt;/b&gt;&lt;br&gt;&lt;br&gt;&lt;span style='font-family:monospace;font-size:11px'&gt;New repository (demo-api, demo-api-gitops) · CI variables · New project · Add environments · push to dev&lt;/span&gt;" style="rounded=1;arcSize=8;whiteSpace=wrap;html=1;fillColor=#ffedd5;strokeColor=#c2410c;fontColor=#0f172a;fontSize=13;align=center;verticalAlign=middle;spacing=8;" vertex="1" parent="1"><mxGeometry x="1260" y="490" width="580" height="160" as="geometry"/></mxCell><mxCell id="p8_19" value="" style="edgeStyle=orthogonalEdgeStyle;rounded=1;html=1;strokeColor=#475569;strokeWidth=1.6;fontSize=11;endArrow=block;endFill=1;labelBackgroundColor=#ffffff;" edge="1" parent="1" source="p8_16" target="p8_18"><mxGeometry relative="1" as="geometry"/></mxCell><mxCell id="p8_20" value="&lt;b&gt;Daily&lt;/b&gt;&lt;ul style='margin:4px 0 0 0;padding-left:16px'&gt;&lt;li&gt;minikube start&lt;/li&gt;&lt;li&gt;kubectl port-forward svc/argocd-server -n argocd 8081:443&lt;/li&gt;&lt;li&gt;(optional) kubectl -n monitoring port-forward svc/kube-prometheus-stack-grafana 3000:80&lt;/li&gt;&lt;li&gt;backend: npm start · frontend: npm run dev&lt;/li&gt;&lt;li&gt;minikube stop at the end of the day&lt;/li&gt;&lt;/ul&gt;" style="rounded=1;arcSize=8;whiteSpace=wrap;html=1;fillColor=#fffbeb;strokeColor=#a16207;fontColor=#0f172a;fontSize=12;align=left;verticalAlign=top;spacing=8;" vertex="1" parent="1"><mxGeometry x="40" y="690" width="900" height="250" as="geometry"/></mxCell><mxCell id="p8_21" value="&lt;b&gt;Ports &amp; logins&lt;/b&gt;&lt;ul style='margin:4px 0 0 0;padding-left:16px'&gt;&lt;li&gt;UI http://localhost:5173 · API http://localhost:5000/api&lt;/li&gt;&lt;li&gt;ArgoCD https://localhost:8081 (admin, argocd-initial-admin-secret)&lt;/li&gt;&lt;li&gt;Grafana http://localhost:3000 · MongoDB 27017&lt;/li&gt;&lt;li&gt;Seed login admin@kubeorbit.local (change the password)&lt;/li&gt;&lt;li&gt;Code: github.com/Pandi2352/devops_intelligence (main)&lt;/li&gt;&lt;/ul&gt;" style="rounded=1;arcSize=8;whiteSpace=wrap;html=1;fillColor=#f1f5f9;strokeColor=#334155;fontColor=#0f172a;fontSize=12;align=left;verticalAlign=top;spacing=8;" vertex="1" parent="1"><mxGeometry x="960" y="690" width="900" height="250" as="geometry"/></mxCell></root></mxGraphModel></diagram></mxfile>
