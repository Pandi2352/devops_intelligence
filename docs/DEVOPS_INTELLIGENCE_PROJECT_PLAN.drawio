uide /guide&lt;/b&gt;: renders docs/DEVOPS_INTELLIGENCE_USER_GUIDE.md" style="rounded=1;arcSize=8;whiteSpace=wrap;html=1;fillColor=#dbeafe;strokeColor=#1d4ed8;fontColor=#0f172a;fontSize=11;align=left;verticalAlign=middle;spacing=8;" vertex="1" parent="1"><mxGeometry x="60" y="264" width="860" height="54" as="geometry"/></mxCell><mxCell id="p6_7" value="&lt;b&gt;Manager Approvals /approvals&lt;/b&gt;: approval queue (does not execute yet)" style="rounded=1;arcSize=8;whiteSpace=wrap;html=1;fillColor=#dbeafe;strokeColor=#1d4ed8;fontColor=#0f172a;fontSize=11;align=left;verticalAlign=middle;spacing=8;" vertex="1" parent="1"><mxGeometry x="60" y="326" width="860" height="54" as="geometry"/></mxCell><mxCell id="p6_8" value="&lt;b&gt;DevOps Copilot /copilot&lt;/b&gt;: assistant (canned answers)" style="rounded=1;arcSize=8;whiteSpace=wrap;html=1;fillColor=#dbeafe;strokeColor=#1d4ed8;fontColor=#0f172a;fontSize=11;align=left;verticalAlign=middle;spacing=8;" vertex="1" parent="1"><mxGeometry x="60" y="388" width="860" height="54" as="geometry"/></mxCell><mxCell id="p6_9" value="&lt;b&gt;Workloads &amp; GitOps&lt;/b&gt;" style="rounded=1;arcSize=2;dashed=1;whiteSpace=wrap;html=1;fillColor=#dbeafe;strokeColor=#1d4ed8;fontColor=#0f172a;fontSize=13;align=center;verticalAlign=top;spacing=8;fillOpacity=35;" vertex="1" parent="1"><mxGeometry x="40" y="470" width="900" height="278" as="geometry"/></mxCell><mxCell id="p6_10" value="&lt;b&gt;Resource Browser&lt;/b&gt;: every kind, pod details" style="rounded=1;arcSize=8;whiteSpace=wrap;html=1;fillColor=#dbeafe;strokeColor=#1d4ed8;fontColor=#0f172a;fontSize=11;align=left;verticalAlign=middle;spacing=8;" vertex="1" parent="1"><mxGeometry x="60" y="500" width="860" height="54" as="geometry"/></mxCell><mxCell id="p6_11" value="&lt;b&gt;Environments&lt;/b&gt;: what runs where, promote, rollback, history, details" style="rounded=1;arcSize=8;whiteSpace=wrap;html=1;fillColor=#dbeafe;strokeColor=#1d4ed8;fontColor=#0f172a;fontSize=11;align=left;ve