PORT=5000
MONGODB_URI=mongodb://127.0.0.1:27017/kubeorbit
JWT_SECRET=kubeorbit-super-secure-jwt-secret-key-2025
JWT_EXPIRES_IN=7d
NODE_ENV=development

# Kubernetes Configuration (Defaults to local ~/.kube/config if empty)
KUBECONFIG_PATH=

# Local ArgoCD (can be overridden)
ARGOCD_SERVER_URL=https://localhost:8080
ARGOCD_AUTH_TOKEN=

# Frontend URL for CORS
FRONTEND_URL=http://localhost:5173

# Key used to encrypt connector credentials (PATs, tokens, kubeconfigs) at rest.
# Set a long random value and keep it stable: changing it makes saved credentials unreadable.
CREDENTIALS_SECRET=
