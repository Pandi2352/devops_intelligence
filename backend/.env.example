PORT=5000
MONGODB_URI=mongodb://127.0.0.1:27017/kubeorbit
# Random, at least 32 characters: node -e "console.log(require('crypto').randomBytes(48).toString('hex'))"
JWT_SECRET=
JWT_EXPIRES_IN=12h
NODE_ENV=development

# Kubernetes Configuration (Defaults to local ~/.kube/config if empty)
KUBECONFIG_PATH=

# Local ArgoCD (can be overridden)
ARGOCD_SERVER_URL=https://localhost:8080
ARGOCD_AUTH_TOKEN=

# Frontend URL for CORS
FRONTEND_URL=http://localhost:5173

# Key used to encrypt connector credentials (PATs, tokens, kubeconfigs) at rest.
# Set a long random value and keep it stable: changing it makes saved credentials unreadable.
CREDENTIALS_SECRET=

# Self sign-up (always creates a Viewer with no project access). Off by default: admins create users.
ALLOW_SIGNUP=false
# Development only: allows the seeded test accounts (npm run seed:test-users) and shows the test admin on the login page.
ENABLE_TEST_ACCOUNTS=false
